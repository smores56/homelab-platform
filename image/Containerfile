# Derived uCore bootc image for smortress. Built by scripts/build-image.sh and
# published by .github/workflows/publish-server-image.yml.
#
# The base is a digest-pinned uCore stable-nvidia image. Everything this file
# adds is non-secret configuration, systemd units, Quadlets, SOPS ciphertext
# and hash-pinned host binaries. No signing key, age identity or LUKS key ever
# enters the image.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG SOPS_VERSION
ARG SOPS_SHA256
ARG AGE_VERSION
ARG AGE_SHA256
ARG RESTIC_VERSION
ARG RESTIC_SHA256
ARG CLOUDFLARED_VERSION
ARG CLOUDFLARED_SHA256

LABEL org.opencontainers.image.title="smortress server image" \
      org.opencontainers.image.description="Derived uCore bootc image for the smortress core" \
      org.opencontainers.image.source="https://github.com/smores56/homelab-platform" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.vendor="smores56"

# Runtime helpers, units and ciphertext. The public cosign key is the only
# signature-related material in the image; the policy references it by path.
COPY image/rootfs/ /
COPY units/systemd/ /usr/lib/systemd/system/
COPY units/quadlet/pattern.container /usr/share/smortress/quadlet/pattern.container
# /usr/local is a symlink to /var on bootc, so helpers go under /usr/libexec
# and lose the .sh suffix that the units would otherwise have to know about.
COPY scripts/storage-layout.sh scripts/zfs-ready.sh scripts/sops-decrypt.sh scripts/init-zpool.sh \
     scripts/open-hdd.sh scripts/access-bootstrap.sh scripts/access-lockdown.sh \
     scripts/fix-crypttab.sh \
     scripts/restic-plane-common.sh scripts/smortress-restic-backup.sh \
     scripts/smortress-restic-verify.sh scripts/smortress-restic-init.sh \
     scripts/smortress-restic-restore-drill.sh \
     scripts/app-secrets.sh scripts/immich-dump.sh scripts/tailscale-serve.sh \
     scripts/apps-quota.sh scripts/apps-user.sh \
     /usr/libexec/smortress-src/
# Application Quadlets. The generator scans /usr/share/containers/systemd at
# boot, and a quadlet is a generated unit, so nothing here is enabled with
# systemctl: the [Install] section is what starts it.
COPY units/systemd/user@1001.service.d/ /usr/lib/systemd/system/user@1001.service.d/
COPY units/systemd/user-1001.slice.d/ /usr/lib/systemd/system/user-1001.slice.d/
COPY units/quadlet/immich.network units/quadlet/immich-postgres.container \
     units/quadlet/immich-valkey.container \
     units/quadlet/immich-machine-learning.container \
     units/quadlet/immich-server.container units/quadlet/opdshelf.container \
     units/quadlet/opdshelf.network units/quadlet/syncthing.container \
     /usr/share/containers/systemd/
COPY secrets/server/ /etc/smortress/secrets/
COPY image/cosign.pub /etc/pki/containers/smortress.pub

COPY scripts/apps-schema.py /usr/libexec/apps-schema
RUN set -eux; \
    for f in /usr/libexec/smortress-src/*.sh; do install -m 0755 "$f" "/usr/libexec/$(basename "${f%.sh}")"; done; \
    rm -rf /usr/libexec/smortress-src; \
    chmod 0755 /usr/libexec/apps-schema; \
    chmod 0644 /etc/pki/containers/smortress.pub /etc/smortress/secrets.manifest; \
    chmod 0600 /etc/smortress/secrets/*.yaml; \
    chmod 0644 /etc/pam.d/sudo; \
    chmod 0440 /etc/sudoers.d/10-human-gate; \
    visudo -cf /etc/sudoers.d/10-human-gate

# Access through the tunnel is the only route in (design #748), so an sshd that
# refuses to parse would take the host off the network with no recovery but a
# console. `sshd -t` parses the shipped /etc/ssh/sshd_config, which includes the
# sshd_config.d drop-in; a container build carries no host keys yet (sshd-keygen
# runs at first boot) and sshd refuses to parse without one, so the check runs
# against a throwaway key that is deleted in the same layer.
RUN set -eux; \
    mkdir -p /run/sshd; \
    tmp=$(mktemp -d); \
    ssh-keygen -q -t ed25519 -N '' -f "$tmp/hostkey"; \
    if ! sshd -t -o HostKey="$tmp/hostkey"; then \
      echo "the shipped sshd configuration does not parse; this build must not ship" >&2; \
      exit 1; \
    fi; \
    rm -rf "$tmp"

# Host binaries: release artifacts with a pinned SHA-256, not distribution
# packages, so the version that boots matches the version reviewed here.
RUN set -eux; \
    curl -fsSLo /tmp/sops \
      "https://github.com/getsops/sops/releases/download/v${SOPS_VERSION}/sops-v${SOPS_VERSION}.linux.amd64"; \
    echo "${SOPS_SHA256}  /tmp/sops" | sha256sum -c -; \
    install -m 0755 /tmp/sops /usr/bin/sops; \
    curl -fsSLo /tmp/age.tar.gz \
      "https://github.com/FiloSottile/age/releases/download/v${AGE_VERSION}/age-v${AGE_VERSION}-linux-amd64.tar.gz"; \
    echo "${AGE_SHA256}  /tmp/age.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/age.tar.gz -C /tmp; \
    install -m 0755 /tmp/age/age /tmp/age/age-keygen /usr/bin/; \
    curl -fsSLo /tmp/restic.bz2 \
      "https://github.com/restic/restic/releases/download/v${RESTIC_VERSION}/restic_${RESTIC_VERSION}_linux_amd64.bz2"; \
    echo "${RESTIC_SHA256}  /tmp/restic.bz2" | sha256sum -c -; \
    bzip2 -dc /tmp/restic.bz2 > /usr/bin/restic; \
    chmod 0755 /usr/bin/restic; \
    curl -fsSLo /tmp/cloudflared \
      "https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/cloudflared-linux-amd64"; \
    echo "${CLOUDFLARED_SHA256}  /tmp/cloudflared" | sha256sum -c -; \
    install -m 0755 /tmp/cloudflared /usr/bin/cloudflared; \
    rm -rf /tmp/sops /tmp/age /tmp/age.tar.gz /tmp/restic.bz2 /tmp/cloudflared

# bootc images enable units with systemctl at build time. rpm-ostree and zincati
# automatic updates are masked: a deployment change lands in a maintenance
# window through bootc, and stateful Podman images are never auto-updated.
RUN set -eux; \
    systemctl enable \
      zfs.target \
      zfs-import-scan.service \
      zfs-mount.service \
      zfs-zed.service \
      smortress-zpool.service \
      smortress-cryptsetup-hdd.service \
      smortress-access-bootstrap.service \
      smortress-crypttab-fix.service \
      firewalld.service \
      smortress-tailscale-up.service \
      smortress-tailscale-ssh-off.service \
      sops-decrypt.service \
      tailscaled.service \
      zfs-ready@raw-files.service \
      zfs-ready@raw-photos.service \
      zfs-ready@raw-books.service \
      zfs-ready@raw-music.service \
      zfs-ready@raw-wallpapers.service \
      zfs-ready@raw-git.service \
      zfs-ready@raw-apps.service \
      zfs-ready@raw-repo-archive.service \
      zfs-ready@state-immich-postgres.service \
      zfs-ready@state-immich-dumps.service \
      zfs-ready@state-syncthing-config.service \
      zfs-ready@state-opdshelf.service \
      smortress-app-secrets.service \
      smortress-apps-user.service \
      smortress-apps-quota.service \
      smortress-apps-egress.service \
      smortress-tailscale-serve.service \
      smortress-cloudflared.service \
      smortress-immich-dump.timer \
      var-lib-restic-ssd.mount \
      var-lib-restic-hdd.mount \
      smortress-restic-init.service \
      smortress-restic-verify.timer \
      smortress-restic-backup-ssd.timer \
      smortress-restic-backup-hdd.timer \
      smortress-restic-backup-r2.timer; \
    systemctl enable 'zfs-scrub-weekly@smortress.timer'; \
    systemctl mask \
      podman-auto-update.timer \
      bootc-fetch-apply-updates.timer \
      rpm-ostreed-automatic.timer \
      zincati.service

# Only tailscale0 carries SSH and application traffic; everything else lands
# in the drop zone. The zone file binds tailscale0 and lists the permitted
# services; ports are added there, never published on 0.0.0.0/::.
RUN firewall-offline-cmd --set-default-zone=drop

# Fail the build if the base is not digest-pinned, the policy no longer rejects
# by default, or the escalation tooling the runbooks depend on is absent.
RUN set -eux; \
    case "${BASE_IMAGE}" in *@sha256:*) ;; *) echo "BASE_IMAGE is not digest-pinned" >&2; exit 1 ;; esac; \
    command -v python3 >/dev/null || { echo "the image has no python3 for the plan verifier" >&2; exit 1; }; \
    jq -e '.default[0].type == "reject"' /etc/containers/policy.json >/dev/null; \
    jq -e '.transports.docker["ghcr.io/smores56/homelab-platform"][0].keyPath == "/etc/pki/containers/smortress.pub"' /etc/containers/policy.json >/dev/null; \
    test -f /usr/lib64/security/pam_userdb.so || { echo "pam_userdb.so is missing: it is the sudo PIN gate (design #748)" >&2; exit 1; }; \
    command -v gdbmtool >/dev/null || { echo "gdbmtool is missing: the sudo PIN database (docs/manual-steps.md section 45) cannot be built with it" >&2; exit 1; }
