# Derived uCore bootc image for smortress. Built by scripts/build-image.sh and
# published by .github/workflows/publish-server-image.yml.
#
# The base is a digest-pinned uCore stable-nvidia image. Everything this file
# adds is non-secret configuration, systemd units, Quadlets, SOPS ciphertext
# and hash-pinned host binaries. No signing key, age identity or LUKS key ever
# enters the image.

ARG BASE_IMAGE

# The stage for the two things Fedora does not package in a usable form: the PAM
# module sudo loads (pam_rssh, design #767 T8) and the local SELinux module that
# lets sudo_t reach the forwarded agent socket. Both leave as files, so the stage
# is discarded and the image keeps no toolchain from it.
#
# pam_rssh is a Rust cdylib linked against openssl and libpam, so a `.so` copied
# from anywhere else would be an ABI mismatch found at the first sudo prompt
# rather than here. `--locked` makes the committed Cargo.lock the dependency set,
# and `--recurse-submodules` is required: pam_rssh vendors its agent protocol in
# dep/ssh-agent.rs, and the clone fails at compile time without it.
#
# No local SELinux policy ships. On this base sudo runs unconfined: /usr/bin/sudo
# is labelled sudo_exec_t but the process stays unconfined_t, `sudo_t` does not
# resolve as a type, and an unconfined domain already holds every permission the
# forwarded agent socket needs. A module for sudo_t could not even link (verified
# on the host), and a policy for unconfined_t would grant nothing it lacks. The
# tripwire is the AVC drill in manual-steps section 45: if a future base confines
# sudo, `denied { connectto }` names the domain to write the rule for.
FROM ${BASE_IMAGE} AS sudo-build

ARG BASE_IMAGE
ARG PAM_RSSH_VERSION
ARG PAM_RSSH_COMMIT

RUN set -eux; \
    dnf5 -y --setopt=install_weak_deps=False install \
      cargo rustc gcc make git pkgconf-pkg-config \
      openssl-devel pam-devel; \
    dnf5 clean all; \
    rm -rf /var/cache/dnf /var/cache/libdnf5

# The tag is what the build asks for and the commit is what it must land on: a
# release retagged upstream fails here instead of shipping unreviewed code.
# CARGO_HOME is set explicitly: uCore's /root is a symlink to /var/roothome, which
# does not exist in this stage, so cargo cannot create $HOME/.cargo and dies with
# "failed to create directory /root/.cargo: File exists" before it compiles
# anything. A path under /src is writable and disappears with the stage.
RUN set -eux; \
    export CARGO_HOME=/src/cargo; \
    git clone --depth 1 --branch "${PAM_RSSH_VERSION}" --recurse-submodules \
      https://github.com/z4yx/pam_rssh /src/pam_rssh; \
    test "$(git -C /src/pam_rssh rev-parse HEAD^{commit})" = "${PAM_RSSH_COMMIT}" \
      || { echo "pam_rssh ${PAM_RSSH_VERSION} is not commit ${PAM_RSSH_COMMIT}; a retagged release invalidates this pin" >&2; exit 1; }; \
    cargo build --release --locked --manifest-path /src/pam_rssh/Cargo.toml

FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG SOPS_VERSION
ARG SOPS_SHA256
ARG AGE_VERSION
ARG AGE_SHA256
ARG RESTIC_VERSION
ARG RESTIC_SHA256
ARG CLOUDFLARED_VERSION
ARG CLOUDFLARED_SHA256

LABEL org.opencontainers.image.title="smortress server image" \
      org.opencontainers.image.description="Derived uCore bootc image for the smortress core" \
      org.opencontainers.image.source="https://github.com/smores56/homelab-platform" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.vendor="smores56"

# No package layer. sudo's touch factor is pam_rssh, which Fedora does not
# package, and the SELinux module is local: both are built in the sudo-build
# stage above and arrive as files, which is why this image neither installs nor
# removes a distribution package.

# Runtime helpers, units and ciphertext. The public cosign key is the only
# signature-related material in the image; the policy references it by path.
COPY image/rootfs/ /
# The build-stage artifact: the PAM module the sudo stack loads.
COPY --from=sudo-build /src/pam_rssh/target/release/libpam_rssh.so /usr/lib64/security/libpam_rssh.so
COPY units/systemd/ /usr/lib/systemd/system/
COPY units/quadlet/pattern.container /usr/share/smortress/quadlet/pattern.container
# /usr/local is a symlink to /var on bootc, so helpers go under /usr/libexec
# and lose the .sh suffix that the units would otherwise have to know about.
COPY scripts/storage-layout.sh scripts/zfs-ready.sh scripts/sops-decrypt.sh scripts/init-zpool.sh \
     scripts/open-hdd.sh scripts/access-bootstrap.sh scripts/access-lockdown.sh \
     scripts/fix-crypttab.sh \
     scripts/restic-plane-common.sh scripts/smortress-restic-backup.sh \
     scripts/smortress-restic-verify.sh scripts/smortress-restic-init.sh \
     scripts/smortress-restic-restore-drill.sh \
     scripts/app-secrets.sh scripts/immich-dump.sh scripts/tailscale-serve.sh \
     scripts/apps-quota.sh scripts/apps-user.sh scripts/agent-config-seed.sh \
     scripts/smortress-password.sh \
     /usr/libexec/smortress-src/
# Application Quadlets. The generator scans /usr/share/containers/systemd at
# boot, and a quadlet is a generated unit, so nothing here is enabled with
# systemctl: the [Install] section is what starts it.
COPY units/systemd/user@1001.service.d/ /usr/lib/systemd/system/user@1001.service.d/
COPY units/systemd/user-1001.slice.d/ /usr/lib/systemd/system/user-1001.slice.d/
COPY units/quadlet/immich.network units/quadlet/immich-postgres.container \
     units/quadlet/immich-valkey.container \
     units/quadlet/immich-machine-learning.container \
     units/quadlet/immich-server.container units/quadlet/opdshelf.container \
     units/quadlet/opdshelf.network units/quadlet/syncthing.container \
     units/quadlet/agent-local.network units/quadlet/agent-general.network \
     units/quadlet/agent-model.container units/quadlet/agent-local.container \
     units/quadlet/agent-general.container units/quadlet/agent-proxy.container \
     units/quadlet/agent-facade-personal.container \
     units/quadlet/agent-facade-general.container \
     units/quadlet/agent-webui-personal.container \
     units/quadlet/agent-webui-general.container \
     units/quadlet/agent-collect.network units/quadlet/agent-tmail.container \
     /usr/share/containers/systemd/
COPY secrets/server/ /etc/smortress/secrets/
COPY image/cosign.pub /etc/pki/containers/smortress.pub

# The hosted-model proxy is a python program, not a shell helper, so it keeps its
# name and needs its own mode: the smortress-src loop below only strips `.sh`.
COPY scripts/apps-schema.py /usr/libexec/apps-schema
COPY apps/agent_proxy/proxy.py /usr/libexec/agent-proxy
# The source facade (apps/agent_facade/) runs in the agent-runtime image, which
# does not carry it and cannot be rebuilt here. The image therefore installs the
# program and the data-plane libraries it imports under /usr/lib/agent-facade, and
# the two facade Quadlets bind-mount that tree read-only -- the same delivery as
# /usr/libexec/agent-proxy above, one directory instead of one file. The modules
# are listed one by one rather than as a directory: tests/ must not reach the host
# image, and a new module that is not listed here fails at import time in the
# container instead of shipping silently.
COPY libs/data_plane/ /usr/lib/agent-facade/libs/data_plane/
COPY apps/agent_facade/__init__.py apps/agent_facade/__main__.py \
     apps/agent_facade/contracts.py apps/agent_facade/memory.py \
     apps/agent_facade/server.py apps/agent_facade/sources.py \
     apps/agent_facade/replica_sources.py apps/agent_facade/source_index.py \
     /usr/lib/agent-facade/apps/agent_facade/
RUN set -eux; \
    for f in /usr/libexec/smortress-src/*.sh; do install -m 0755 "$f" "/usr/libexec/$(basename "${f%.sh}")"; done; \
    rm -rf /usr/libexec/smortress-src; \
    chmod 0755 /usr/libexec/apps-schema /usr/libexec/agent-proxy; \
    chmod 0644 /etc/pki/containers/smortress.pub /etc/smortress/secrets.manifest; \
    chmod 0600 /etc/smortress/secrets/*.yaml; \
    chmod 0644 /etc/pam.d/sudo; \
    chmod 0600 /etc/ssh/sudo_authorized_keys; \
    chmod 0440 /etc/sudoers.d/10-human-gate /etc/sudoers.d/20-sops-env; \
    visudo -cf /etc/sudoers.d/10-human-gate; \
    visudo -cf /etc/sudoers.d/20-sops-env

# The tailnet is the only route in and the key shipped in this image is the only
# credential (design #767), so an sshd that refuses to parse would take the host
# off the network with no recovery but a console. `sshd -t` parses the shipped
# /etc/ssh/sshd_config, which includes the sshd_config.d drop-in; a container
# build carries no host keys yet (sshd-keygen runs at first boot) and sshd
# refuses to parse without one, so the check runs against a throwaway key that is
# deleted in the same layer.
RUN set -eux; \
    mkdir -p /run/sshd; \
    tmp=$(mktemp -d); \
    ssh-keygen -q -t ed25519 -N '' -f "$tmp/hostkey"; \
    if ! sshd -t -o HostKey="$tmp/hostkey"; then \
      echo "the shipped sshd configuration does not parse; this build must not ship" >&2; \
      exit 1; \
    fi; \
    rm -rf "$tmp"

# Host binaries: release artifacts with a pinned SHA-256, not distribution
# packages, so the version that boots matches the version reviewed here.
RUN set -eux; \
    curl -fsSLo /tmp/sops \
      "https://github.com/getsops/sops/releases/download/v${SOPS_VERSION}/sops-v${SOPS_VERSION}.linux.amd64"; \
    echo "${SOPS_SHA256}  /tmp/sops" | sha256sum -c -; \
    install -m 0755 /tmp/sops /usr/bin/sops; \
    curl -fsSLo /tmp/age.tar.gz \
      "https://github.com/FiloSottile/age/releases/download/v${AGE_VERSION}/age-v${AGE_VERSION}-linux-amd64.tar.gz"; \
    echo "${AGE_SHA256}  /tmp/age.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/age.tar.gz -C /tmp; \
    install -m 0755 /tmp/age/age /tmp/age/age-keygen /usr/bin/; \
    curl -fsSLo /tmp/restic.bz2 \
      "https://github.com/restic/restic/releases/download/v${RESTIC_VERSION}/restic_${RESTIC_VERSION}_linux_amd64.bz2"; \
    echo "${RESTIC_SHA256}  /tmp/restic.bz2" | sha256sum -c -; \
    bzip2 -dc /tmp/restic.bz2 > /usr/bin/restic; \
    chmod 0755 /usr/bin/restic; \
    curl -fsSLo /tmp/cloudflared \
      "https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/cloudflared-linux-amd64"; \
    echo "${CLOUDFLARED_SHA256}  /tmp/cloudflared" | sha256sum -c -; \
    install -m 0755 /tmp/cloudflared /usr/bin/cloudflared; \
    rm -rf /tmp/sops /tmp/age /tmp/age.tar.gz /tmp/restic.bz2 /tmp/cloudflared

# bootc images enable units with systemctl at build time. rpm-ostree and zincati
# automatic updates are masked: a deployment change lands in a maintenance
# window through bootc, and stateful Podman images are never auto-updated.
RUN set -eux; \
    systemctl enable \
      zfs.target \
      zfs-import-scan.service \
      zfs-mount.service \
      zfs-zed.service \
      smortress-zpool.service \
      smortress-cryptsetup-hdd.service \
      smortress-access-bootstrap.service \
      smortress-crypttab-fix.service \
      firewalld.service \
      smortress-tailscale-up.service \
      smortress-tailscale-ssh-off.service \
      sops-decrypt.service \
      smortress-password.service \
      tailscaled.service \
      zfs-ready@raw-files.service \
      zfs-ready@raw-photos.service \
      zfs-ready@raw-books.service \
      zfs-ready@raw-music.service \
      zfs-ready@raw-wallpapers.service \
      zfs-ready@raw-git.service \
      zfs-ready@raw-apps.service \
      zfs-ready@raw-repo-archive.service \
      zfs-ready@state-immich-postgres.service \
      zfs-ready@state-immich-dumps.service \
      zfs-ready@state-syncthing-config.service \
      zfs-ready@state-opdshelf.service \
      zfs-ready@state-agent-local.service \
      zfs-ready@state-agent-general.service \
      zfs-ready@state-agent-model.service \
      smortress-app-secrets.service \
      smortress-agent-config.service \
      smortress-nvidia-cdi.service \
      smortress-apps-user.service \
      smortress-apps-quota.service \
      smortress-apps-egress.service \
      smortress-tailscale-serve.service \
      smortress-cloudflared.service \
      smortress-immich-dump.timer \
      smortress-agent-collect-finance.timer \
      smortress-agent-collect-calendar.timer \
      smortress-agent-mail-stream.service \
      var-lib-restic-ssd.mount \
      var-lib-restic-hdd.mount \
      smortress-restic-init.service \
      smortress-restic-verify.timer \
      smortress-restic-backup-ssd.timer \
      smortress-restic-backup-hdd.timer \
      smortress-restic-backup-r2.timer; \
    systemctl enable 'zfs-scrub-weekly@smortress.timer'; \
    systemctl mask \
      podman-auto-update.timer \
      bootc-fetch-apply-updates.timer \
      rpm-ostreed-automatic.timer \
      zincati.service

# Only tailscale0 carries SSH and application traffic; everything else lands
# in the drop zone. The zone file binds tailscale0 and lists the permitted
# services; ports are added there, never published on 0.0.0.0/::.
RUN firewall-offline-cmd --set-default-zone=drop

# Fail the build if the base is not digest-pinned, the policy no longer rejects
# by default, or the escalation tooling the runbooks depend on is absent.
RUN set -eux; \
    case "${BASE_IMAGE}" in *@sha256:*) ;; *) echo "BASE_IMAGE is not digest-pinned" >&2; exit 1 ;; esac; \
    command -v python3 >/dev/null || { echo "the image has no python3 for the plan verifier" >&2; exit 1; }; \
    jq -e '.default[0].type == "reject"' /etc/containers/policy.json >/dev/null; \
    jq -e '.transports.docker["ghcr.io/smores56/homelab-platform"][0].keyPath == "/etc/pki/containers/smortress.pub"' /etc/containers/policy.json >/dev/null; \
    test -s /etc/ssh/authorized_keys.d/smores || { echo "the shipped ssh key file is missing or empty: it is the only key sshd reads (design #767)" >&2; exit 1; }; \
    ! grep -q 'sk-ssh-ed25519' /etc/ssh/authorized_keys.d/smores || { echo "the shipped key file carries a FIDO handle; the image ships a plain ed25519 key (design #767)" >&2; exit 1; }; \
    test -f /usr/lib64/security/libpam_rssh.so || { echo "libpam_rssh.so is missing: it is sudo's touch factor (design #767)" >&2; exit 1; }; \
    test -e /etc/ssh/sudo_authorized_keys || { echo "the sudo key file is missing: libpam_rssh.so reads it on every prompt (design #767)" >&2; exit 1; }; \
    ! test -f /usr/lib64/security/pam_oath.so || { echo "pam_oath.so is still in the image: sudo's TOTP is retired (design #767)" >&2; exit 1; }; \
