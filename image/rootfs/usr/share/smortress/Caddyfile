# The tailnet name service's terminator (design #834, task #845).
#
# This is image data, not host data: it ships under /usr/share, which bootc swaps
# with the deployment, so a site or a provider setting added by a later image
# reaches an existing host. The /etc copy of a file is merged once and keeps
# whatever the host already had, which is why the Quadlet mounts this path.
#
# DNS-01 only. The names are answered on a tailnet Service VIP, which no public CA
# can reach over HTTP, and the edge's own 443 already belongs to Immich and
# OPDShelf, so the challenge has to be answered in the zone that holds the name --
# which is why the image carries the Cloudflare provider module at all. The token
# is the operator store's `tailnet-dns-api-token`, derived into the boot bundle
# and handed in as an environment variable by the Quadlet's Podman secret.
#
# `admin off` is there because nothing on this host drives a Caddy API: the
# routes are this file's, and an open admin endpoint on loopback would be a
# second way to change them. It does not stop the autosave -- `caddy run` writes
# what it loaded to /config on every start regardless -- which is why the Quadlet
# mounts a writable /config beside the read-only root filesystem.
# `auto_https disable_redirects` keeps Caddy off port 80, which is never opened
# on this host.
{
	admin off
	auto_https disable_redirects
}

# 9443, not 443: Serve's `--tcp` forward copies bytes to loopback and terminates
# nothing, so the client's TLS handshake is with this process directly and its SNI
# is what selects the certificate. The bind is loopback because Serve is the only
# peer that may reach the port, and the port is above 1024, so the container needs
# no capability to hold it.
assistant.sammohr.dev:9443 {
	bind 127.0.0.1

	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	reverse_proxy http://127.0.0.1:18006
}

# The general UI is the second name on the same Service and VIP, and the vault
# GUI below is a third. SNI picks the site, so what another name needs is another
# site and nothing else: the port, the bind, the provider and the ACME account
# are shared, and one Service with one Serve endpoint already answers all of them
# because the certificate never leaves this process. Only the target differs --
# each UI is its own container on its own loopback port.
agent.sammohr.dev:9443 {
	bind 127.0.0.1

	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	reverse_proxy http://127.0.0.1:18007
}

# The vault GUI, which is why the Service stopped being agent-only. Syncthing
# binds its GUI to loopback and rejects every request whose Host is not that
# address, a guard that exists because the page embeds the API key. Rewriting
# Host here keeps the guard on in both directions: `<insecureSkipHostcheck>`, the
# alternative, disables it for the whole GUI and API, and was only ever the
# interim way in before this name existed.
sync.sammohr.dev:9443 {
	bind 127.0.0.1

	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	reverse_proxy http://127.0.0.1:8384 {
		header_up Host 127.0.0.1:8384
	}
}
