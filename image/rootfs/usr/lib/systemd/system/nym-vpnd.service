# The NymVPN daemon; `nym-vpnc` drives it over /var/run/nym-vpn.sock.
#
# Nym ships no Fedora package, so this unit is ours: upstream's own has no
# hardening, no state or log directories, and puts StartLimit* under [Service],
# where systemd ignores it.
#
# The daemon logs to a file, not the journal: `run-as-service` turns stdout
# logging off, so journalctl shows only systemd's own start and stop lines and
# the real log is /var/log/nym-vpnd/nym-vpnd.log.
[Unit]
Description=NymVPN daemon
# NYM_DNS_MODULE=systemd fails instead of degrading when resolved is missing,
# so ordering on it is what keeps the start deterministic.
After=NetworkManager.service systemd-resolved.service network-online.target
Wants=network-online.target
# A dropped Wi-Fi link must not turn a restart into a failed unit for the rest
# of the session: Restart=always below is bounded only here.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/nym-vpnd run-as-service
# A SIGKILLed daemon leaves its nftables kill-switch table dropping traffic.
# The `-` prefix is what makes a missing table a no-op; systemd does not shell.
ExecStartPre=-/usr/sbin/nft delete table inet nym
ExecStopPost=-/usr/sbin/nft delete table inet nym
Restart=always
RestartSec=2
# Modes for the config and log files only. The control socket is chmod 0666 by
# the daemon itself and is authorized by SO_PEERCRED, not by file mode.
UMask=0077
# No `nym-vpn` group is created on purpose: membership is a passwordless path
# to a root daemon. The CLI runs as root through sudo, which the daemon
# authorizes outright; the baked polkit action is the fallback for anyone else.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# The daemon writes the tunnel address and routing over netlink, its own
# sysctls, and the kill-switch through libnftnl; these two would block it.
ProtectKernelTunables=false
ProtectControlGroups=false
# /run/nym-vpn.sock is hardcoded and sits directly in /run, so RuntimeDirectory
# cannot cover it and /run has to stay writable. The daemon is root regardless:
# this sandbox is depth, not a boundary.
ReadWritePaths=/run
StateDirectory=nym-vpnd
StateDirectoryMode=0700
LogsDirectory=nym-vpnd
LogsDirectoryMode=0700
# Host DNS is systemd-resolved. Pin the backend: auto-detect would otherwise
# fall back to rewriting /etc/resolv.conf, which ProtectSystem=strict forbids.
Environment=NYM_DNS_MODULE=systemd
# Upstream defaults the config to /etc/nym; keep it in the state directory so
# nothing writes /etc on a bootc host, where updates are three-way merged.
Environment=NYM_VPND_CONFIG_DIR=/var/lib/nym-vpnd/config
Environment=NYM_VPND_LOG_DIR=/var/log/nym-vpnd

[Install]
WantedBy=multi-user.target
