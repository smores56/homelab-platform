# sudo on smortress (design #767, T8).
#
# One gesture: a touch on the YubiKey that is already in the client. sshd
# forwards the agent, libpam_rssh asks it for a signature, and the agent holds
# only a touch-required sk-ssh-ed25519 credential, so the tap happens at the
# laptop. The account password stays behind it as the fallback, so an absent,
# unplugged or unmapped key costs typing rather than access. The token is
# convenience by construction, not a gate: an agent running as smores does not
# hold the account password, and that is the whole of what the split buys.
#
# The jump arithmetic is the security property, so it is spelled out. Linux-PAM
# reads `N` in `success=N` as "skip the next N modules in the stack", and `ignore`
# in `default=` as "record the failure and continue" (pam.conf(5), the actionN
# list). Row by row:
#
#   1 pam_rssh success (success=2)    -> skips rows 2 and 3 and lands on row 4,
#                                        authsucc: the tally is cleared and the
#                                        stack succeeds.
#   1 anything else (default=ignore)  -> row 2, the password. Every non-success
#                                        from pam_rssh lands here, which is the
#                                        fallback.
#   2 pam_unix success (success=1)    -> skips row 3 and lands on row 4, authsucc.
#   2 pam_unix failure (default=ignore) -> row 3, authfail, which dies.
#   3 authfail (default=die)          -> the tally is incremented, sudo refused.
#
# A bare `sufficient` on the touch row would be wrong: a sufficient success
# terminates dispatch (`pam_dispatch.c`, `goto decision_made`), so authsucc would
# never run and the tally would never clear -- five refusals over any period
# would lock the account out of every later sudo. `success=2` reaches authsucc,
# and so does the password row's `success=1`, so a tap and the password both
# clear the tally.
#
# The fallback is a property of pam_rssh's return codes, not of arithmetic kept
# by hand: no SSH_AUTH_SOCK is PAM_AUTHINFO_UNAVAIL, and a dead socket, a key the
# agent does not hold or a refused touch is PAM_AUTH_ERR (src/lib.rs). The module
# never returns PAM_IGNORE, so `default=ignore` on its row is what sends every
# one of those to pam_unix -- an unplugged key is a password prompt.
#
# pam_rssh reads the socket path from the process environment
# (getenv("SSH_AUTH_SOCK"), src/lib.rs), so sudo must keep that variable:
# sudoers.d/10-human-gate carries `Defaults env_keep += "SSH_AUTH_SOCK"`.
# Without it the module logs "SSH agent socket address not configured" and every
# escalation falls back to the password -- the first deployment of this stack did
# exactly that, and the failure is invisible at the prompt.
#
# There is no console break-glass row any more. The password fallback is the
# break-glass everywhere, which is what it is for; a /dev/tty* login takes the
# same two rows as an ssh session.

# Deny before the prompt, and before any comparison, when the account is locked.
auth  required                   pam_faillock.so preauth deny=5 unlock_time=300
# The touch. auth_key_file is the image-shipped list of the sudo credentials'
# public halves -- root-owned 0600 at /etc/ssh/sudo_authorized_keys, deliberately
# not AuthorizedKeysFile: the login credential is minted no-touch-required and
# must never satisfy sudo. The file is empty until the owner enrolls the keys, and
# an empty list is a PAM_AUTH_ERR, so the password is the way in until then.
# `cue` prints the one line that asks for the tap; the tap itself is in the
# client's agent.
auth  [success=2 default=ignore] libpam_rssh.so auth_key_file=/etc/ssh/sudo_authorized_keys cue
# The fallback. try_first_pass is a no-op today: libpam_rssh's `cue` is a
# PAM_TEXT_INFO and sets no authtok, so pam_unix prompts regardless. It stays,
# and it is the reason not to put a prompt-setting module ahead of this row:
# such a module would hand pam_unix a stale value to reuse.
auth  [success=1 default=ignore] pam_unix.so try_first_pass
# Count the failure. faillock records one row per PAM transaction and sudo makes
# several per invocation, so a handful of wrong prompts -- not invocations -- is
# what reaches deny=5 and costs 300 seconds.
auth  [default=die]              pam_faillock.so authfail deny=5 unlock_time=300
# Clear the tally on success, with the deny the tally was counted against. The
# success=N rows above land here for exactly this reason.
auth  sufficient                 pam_faillock.so authsucc deny=5 unlock_time=300
# Fedora's stock sudo phases, unchanged. Dropping them would take the SELinux
# session context, the limits and the account phase with them.
account    include system-auth
password   include system-auth
session    optional pam_keyinit.so revoke
session    required  pam_limits.so
session    include system-auth
