# sudo_t reaching the forwarded ssh-agent socket (design #767, T8).
#
# pam_rssh authenticates by asking the agent named in SSH_AUTH_SOCK for a
# signature, and the socket it is handed is the one sshd forwards: OpenSSH >= 10.1
# creates it under ~/.ssh/agent, which the targeted policy labels ssh_home_t
# (session.c, misc-agent.c). sudo.te never grants the peer-label permission to
# that type, so the connect() is denied, pam_rssh returns PAM_AUTH_ERR and sudo
# falls through to the password -- correct by the design's fallback, but not the
# gesture the design is for. The policy broke agent forwarding outright once
# (selinux-policy#3384, bz2502040), so a local module is the delivery rather than
# a wait for upstream.
#
# The permission is connectto, not connect. selinux_socket_unix_stream_connect
# checks CONNECTTO on the *peer* socket's label -- ssh_home_t here -- while
# unix_stream_socket connect is checked only against the caller's own socket,
# which sudodomain already allows. A module asking for connect therefore grants
# nothing and the tap stays denied, which is what the first cut of this file got
# wrong.
#
# The exact permission set is unproven until the host drill: after a tap,
# `ausearch -m avc -c sudo` is empty if this is complete. `dir search` is here
# because a connect() to a path needs traversal of ~/.ssh and ~/.ssh/agent, which
# are both ssh_home_t; if the drill shows the traversal is already allowed, drop
# that line, and if it shows a further denial, add it here. Either is a one-line
# change to this file, a rebuild, and the loader unit picks up the new .pp.
policy_module(smortress_sudo_rssh, 1.0.0)

require {
    type sudo_t;
    type ssh_home_t;
    class dir { search };
    class unix_stream_socket { connectto };
}

# The socket itself: the check runs on the peer's label.
allow sudo_t ssh_home_t:unix_stream_socket connectto;
# Path traversal to it: ~/.ssh and ~/.ssh/agent carry the same label.
allow sudo_t ssh_home_t:dir search;
