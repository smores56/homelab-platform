# Every external reference the derived image consumes. This is the only file a
# base refresh edits; scripts/build-image.sh refuses a base that is not
# digest-pinned, and scripts/refresh-pins.sh is what rewrites it.
#
# The base is the multi-arch index of Fedora's minimal bootc image for the
# release the laptop runs. It is the same Fedora kernel the official atomic
# desktops ship, which is what keeps shim -> GRUB -> kernel verification
# working without a MOK enrollment.
FEDORA_VERSION=45
BASE_IMAGE=quay.io/fedora/fedora-bootc@sha256:d3f0430d6a5f0df81eaebda4d4a4ea3c3fe2524dfbc135059e7811d35902309d

# The repository CI pushes to. The tag is derived from the commit; the digest
# is what bootc consumes after the signature check.
IMAGE_REPO=ghcr.io/smores56/smorespro-image

# CI-only binaries, downloaded by the publish workflow and hash-checked there.
COSIGN_VERSION=2.6.1
COSIGN_SHA256=064954c5d8c7e3b28188eee5b1727b31c411550bc5fefd41aa672d3c761d103a
