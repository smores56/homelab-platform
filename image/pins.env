# Every external reference the derived image consumes. This is the only file a
# digest refresh edits; scripts/build-image.sh and scripts/render-ignition.sh
# refuse to proceed when an image reference is not digest-pinned.

# uCore stable-nvidia, multi-arch index, published 2026-11-15 03:09:12Z.
# amd64 manifest: sha256:e97dd4593a3b6845820da3aea11c0245f1f243d28df6510ed2da48c3848700f2
# Refresh with `scripts/refresh-pins.sh`; never replace this with a tag.
UCORE_TAG=stable-nvidia
UCORE_DATE=2026-11-15
UCORE_IMAGE=ghcr.io/ublue-os/ucore@sha256:bf251f7668136af11d482dc3c86b49e40d7ef017fea37c5774679a693541a5ed

# The repository our CI pushes to. The tag is derived from the commit; the
# digest is what Ignition and bootc consume.
IMAGE_REPO=ghcr.io/smores56/homelab-platform/server

# Host binaries baked into the image. Releases are downloaded by the build and
# verified against these hashes, so a retagged release fails the build.
SOPS_VERSION=3.13.3
SOPS_SHA256=e5bec3346a873ae91d871550f3e698c1aad962aff462a080e40f25fde17fef6b
AGE_VERSION=1.3.2
AGE_SHA256=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
RESTIC_VERSION=0.19.1
RESTIC_SHA256=f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c

# sudo's touch factor (design #767, T8). pam_rssh is not packaged for Fedora, so
# the image clones the tag and builds the module; the tag is what the build asks
# for and the commit is what it must land on, so a retagged release fails here.
PAM_RSSH_VERSION=v1.2.1
PAM_RSSH_COMMIT=e8dd046c423f85df266c23bcc3d7033bfee81255

# CI-only binaries, downloaded with the same hash check.
BUTANE_VERSION=0.29.0
BUTANE_SHA256=53a20d820fbaa7fda4f1afd1814974badc8e448db4c151d3f1ba005dc29bc4c9
COSIGN_VERSION=2.6.1
COSIGN_SHA256=064954c5d8c7e3b28188eee5b1727b31c411550bc5fefd41aa672d3c761d103a
