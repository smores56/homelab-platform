#!/usr/bin/env bash
# Clean-room restore entrypoint. Restores the newest covering snapshot of every
# selected recovery group from its restic repositories. Backups read the staged
# tree under snapshot_root (/run/data-plane/current), so each snapshot records
# that absolute staged path. This script restores the staged path into a
# temporary directory and moves the group subtree to its real destination under
# the target root, printing that destination and the entry count. There is no
# generation manifest: the ZFS snapshot name is the generation id, completeness
# is the newest snapshot in every required tier, and restic's authenticated
# repository format is the integrity boundary.
#
# Usage:
#   homelab-clean-room-restore [--allow-live] [--verify-only] [--capacity-bytes]
#                              [--overwrite] [--target PATH] [--groups a,b]
# Environment:
#   HOMELAB_RESTORE_CONFIRM=restore
#   HOMELAB_RESTORE_APPLY=1      actually write
#   HOMELAB_RESTORE_ROOT         scratch target (required unless --allow-live)
#   HOMELAB_ALLOW_LIVE=1         explicit --allow-live equivalent
#   HOMELAB_RESTORE_OVERWRITE=1  explicit --overwrite equivalent
#   HOMELAB_RESTORE_GROUPS       comma-separated group ids (default: every group)
#   HOMELAB_REQUIRED_TIERS       comma-separated tiers, every one must hold a snapshot
#   HOMELAB_RECOVERY_MIN_FREE_GB per-snapshot byte estimate when restic records
#                                no summary (default: {{ recovery_min_free_gb }})
set -euo pipefail

sentinel="{{ recovery_sentinel }}"
check_script="{{ recovery_check_script }}"
plan_file="{{ backup_config_file }}"
fence_file="{{ recovery_writer_fence }}"
target_root=${HOMELAB_RESTORE_ROOT:-}
apply=${HOMELAB_RESTORE_APPLY:-0}
confirm=${HOMELAB_RESTORE_CONFIRM:-}
groups=${HOMELAB_RESTORE_GROUPS:-}
required_tiers=${HOMELAB_REQUIRED_TIERS:-"{{ recovery_required_tiers | join(',') }}"}
schema_version=${HOMELAB_PLAN_SCHEMA_VERSION:-"{{ recovery_plan_schema_version }}"}
allow_live=${HOMELAB_ALLOW_LIVE:-0}
overwrite=${HOMELAB_RESTORE_OVERWRITE:-0}
min_free_gb=${HOMELAB_RECOVERY_MIN_FREE_GB:-"{{ recovery_min_free_gb }}"}
verify_only=0
capacity_only=0

die() { printf 'refusing: %s\n' "$1" >&2; exit 1; }
warn() { printf 'WARN %s\n' "$1" >&2; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --allow-live) allow_live=1 ;;
    --verify-only) verify_only=1 ;;
    --capacity-bytes) capacity_only=1 ;;
    --overwrite) overwrite=1 ;;
    --target)
      [[ $# -ge 2 ]] || die "--target needs a path"
      target_root=$2
      shift
      ;;
    --groups)
      [[ $# -ge 2 ]] || die "--groups needs a list"
      groups=$2
      shift
      ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done

[[ $EUID -eq 0 ]] || die "run as root"
[[ -r $sentinel ]] || die "missing recovery sentinel $sentinel"
[[ -r $plan_file ]] || die "missing host backup plan $plan_file"
[[ $confirm == "restore" ]] || die "set HOMELAB_RESTORE_CONFIRM=restore after reading the runbook"
[[ $min_free_gb =~ ^[0-9]+$ ]] || die "HOMELAB_RECOVERY_MIN_FREE_GB must be a whole number of GiB"

# A scratch target is the default. Restoring into the live root is only possible
# behind an explicit fence: recover.yml writes the fence file after stopping
# every writer, and the fence must still exist when this script writes.
if [[ -z $target_root ]]; then
  [[ $allow_live -eq 1 ]] || die "set HOMELAB_RESTORE_ROOT to a scratch target (or pass --allow-live to restore into / after fencing writers)"
  target_root=/
fi
[[ $target_root == /* ]] || die "restore root must be absolute: $target_root"
[[ -d $target_root ]] || die "restore root $target_root does not exist"
[[ $target_root == *..* ]] && die "restore root must not contain .."

if [[ $target_root == "/" ]]; then
  [[ $allow_live -eq 1 ]] || die "refusing to restore into / without --allow-live"
elif [[ $allow_live -ne 1 ]]; then
  # A scratch target that resolves to the root filesystem has no independent
  # capacity and is never scratch; recover.yml additionally requires the target
  # to be its own mount. --allow-live is the explicit override for a live mount.
  mounted=$(findmnt -rn -o TARGET --target "$target_root" 2>/dev/null || true)
  [[ $mounted != "/" ]] || die "restore root $target_root is on the root filesystem; use a dedicated scratch mount (or --allow-live after fencing)"
fi

# The sentinel is informational for a restore: a missing backup mount or a
# stopped portal is a warning, never a prerequisite.
"$check_script" --quiet || warn "recovery sentinel is not satisfied; continuing with the repository gate"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

python3 - "$plan_file" "$schema_version" "$required_tiers" "$groups" >"$work/groups" <<'PY'
import json
import sys

path, schema_version, tiers_csv, groups_csv = sys.argv[1:5]
tiers = [item for item in tiers_csv.split(",") if item]
try:
    with open(path, encoding="utf-8") as handle:
        plan = json.load(handle)
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"cannot read host plan: {exc}")
if plan.get("schema_version") != int(schema_version):
    raise SystemExit("host plan schema_version does not match")
roots = {tier["name"]: tier["repository_root"] for tier in plan.get("tiers", [])}
missing = set(tiers) - set(roots)
if missing:
    raise SystemExit(f"host plan has no tier {', '.join(sorted(missing))}")
known = [group["id"] for group in plan.get("groups", [])]
selected = [item for item in groups_csv.split(",") if item] or known
unknown = set(selected) - set(known)
if unknown:
    raise SystemExit(f"unknown groups: {', '.join(sorted(unknown))}")
for group in plan["groups"]:
    if group["id"] not in selected:
        continue
    missing_group_tiers = set(tiers) - set(group["tiers"])
    if missing_group_tiers:
        raise SystemExit(
            f"group {group['id']} does not target "
            + ", ".join(sorted(missing_group_tiers))
        )
    for tier_name in tiers:
        repository = f"{roots[tier_name].rstrip('/')}/{group['id']}"
        print(
            "\t".join(
                [
                    group["id"],
                    group["path"],
                    plan["snapshot_root"],
                    tier_name,
                    repository,
                    plan["password_file"],
                ]
            )
        )
PY
[[ -s $work/groups ]] || die "the host plan selected no groups"

# Print "<id>\t<bytes>" for the newest snapshot that covers the staged group
# path, or fail. The staged path is what restic recorded, because backups read
# snapshot_root/<path>. A bounded query keeps older covering snapshots visible;
# the newest covering one is selected, never merely the newest snapshot.
snapshot_for() {
  local repo=$1 path=$2 snapshot_root=$3 password_file=$4
  restic snapshots --json --latest 20 --repo "$repo" --password-file "$password_file" 2>/dev/null \
    | python3 -c '
import json
import sys

path, snapshot_root = sys.argv[1:3]
try:
    snapshots = json.load(sys.stdin)
except (json.JSONDecodeError, ValueError):
    raise SystemExit(1)
if not isinstance(snapshots, list) or not snapshots:
    raise SystemExit(1)
expected = snapshot_root.rstrip("/") + "/" + path


def covers(snapshot):
    for candidate in snapshot.get("paths") or []:
        if not isinstance(candidate, str):
            continue
        candidate = candidate.rstrip("/")
        if expected == candidate or expected.startswith(candidate + "/"):
            return True
    return False


covering = [snapshot for snapshot in snapshots if covers(snapshot)]
if not covering:
    raise SystemExit(1)
newest = max(covering, key=lambda snapshot: str(snapshot.get("time", "")))
short = newest.get("short_id") or newest.get("id")
if not isinstance(short, str) or not short:
    raise SystemExit(1)
summary = newest.get("summary") or {}
size = summary.get("total_bytes_processed")
print(short, size if isinstance(size, int) and size > 0 else "", sep="\t")
' "$path" "$snapshot_root"
}

# Every required tier must hold a snapshot that covers the group. Record one
# line per group/tier so a later dedup can pick the first tier in plan order.
build_all() {
  : >"$work/all"
  while IFS=$'\t' read -r group_id path snapshot_root tier repository password_file; do
    out=$(snapshot_for "$repository" "$path" "$snapshot_root" "$password_file") \
      || die "$tier/$group_id is missing a covering snapshot"
    if [[ $out == *$'\t'* ]]; then
      snapshot=${out%%$'\t'*}
      bytes=${out##*$'\t'}
    else
      snapshot=$out
      bytes=""
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$group_id" "$path" "$snapshot_root" "$tier" "$repository" "$snapshot" \
      "$password_file" "$bytes" >>"$work/all"
  done <"$work/groups"
}

build_all

if [[ $verify_only -eq 1 ]]; then
  while IFS=$'\t' read -r group_id _path _snapshot_root tier _repository _snapshot _password_file _bytes; do
    printf 'verified %s in %s\n' "$group_id" "$tier"
  done <"$work/all"
  # verify-only never inspects a restored tree; it proves the repositories and
  # their path coverage. Any tree check belongs to the apply step's output.
  printf 'verify-only: checked repositories and path coverage only; no restored tree was inspected\n'
  exit 0
fi

# Keep one line per group: the first tier in plan order that proved coverage.
python3 - "$work/all" >"$work/steps" <<'PY'
import sys

seen = set()
with open(sys.argv[1], encoding="utf-8") as handle:
    for line in handle:
        group_id = line.split("\t", 1)[0]
        if group_id in seen:
            continue
        seen.add(group_id)
        sys.stdout.write(line)
PY

if [[ $capacity_only -eq 1 ]]; then
  # Bytes the restore needs: the newest covering snapshot per group, times 1.1,
  # plus one min_free_gb estimate for every snapshot restic recorded no size
  # for. recover.yml compares this against the scratch mount's free space.
  python3 - "$work/steps" "$min_free_gb" <<'PY'
import math
import sys

steps_path, min_free_gb = sys.argv[1:3]
fallback = int(min_free_gb) * 1024 ** 3
known = 0
unknown = 0
with open(steps_path, encoding="utf-8") as handle:
    for line in handle:
        fields = line.rstrip("\n").split("\t")
        size = fields[7] if len(fields) > 7 else ""
        if size.isdigit():
            known += int(size)
        else:
            unknown += 1
print(math.ceil(known * 1.1) + unknown * fallback)
PY
  exit 0
fi

destination_for() {
  local path=$1
  if [[ $target_root == "/" ]]; then
    printf '/%s' "$path"
  else
    printf '%s/%s' "${target_root%/}" "$path"
  fi
}

dest_is_empty() {
  local dest=$1 entry
  for entry in "$dest"/* "$dest"/.[!.]* "$dest"/..?*; do
    [[ -e $entry ]] || continue
    return 1
  done
  return 0
}

check_restore_target() {
  local dest=$1
  # A live restore writes over the running tree; it is only allowed while every
  # writer is still fenced. The non-empty refusal below applies to that live
  # path too, so a live restore also needs --overwrite.
  if [[ $target_root == "/" && $allow_live -eq 1 && ! -e $fence_file ]]; then
    die "restoring into / requires the writer fence $fence_file; fence every writer first"
  fi
  if [[ -d $dest ]] && ! dest_is_empty "$dest" && [[ $overwrite -ne 1 ]]; then
    die "destination $dest already holds data; pass --overwrite to replace it"
  fi
}

if [[ $apply -ne 1 ]]; then
  printf 'plan (target root %s):\n' "$target_root"
  while IFS=$'\t' read -r group_id path _snapshot_root tier _repository snapshot _password_file _bytes; do
    printf '  %s: %s snapshot %s -> %s\n' \
      "$group_id" "$tier" "$snapshot" "$(destination_for "$path")"
  done <"$work/steps"
  printf 'dry run: set HOMELAB_RESTORE_APPLY=1 to restore these groups\n'
  exit 0
fi

while IFS=$'\t' read -r group_id path snapshot_root tier repository snapshot password_file _bytes; do
  dest=$(destination_for "$path")
  check_restore_target "$dest"
  stage="$work/stage-$group_id"
  mkdir -p "$stage"
  # restic recorded the staged path, so restore it into the temporary directory
  # and move just that subtree to its real destination.
  restic --repo "$repository" --password-file "$password_file" restore \
    "$snapshot" --target "$stage" --include "$snapshot_root/$path" --verify
  staged="$stage$snapshot_root/$path"
  [[ -d $staged ]] \
    || die "snapshot $snapshot ($tier/$group_id) did not contain $snapshot_root/$path"
  mkdir -p "$(dirname "$dest")"
  if [[ -e $dest ]]; then
    rm -rf -- "$dest"
  fi
  mv -- "$staged" "$dest"
  count=$(find "$dest" -mindepth 1 -printf '.' | wc -c)
  printf 'restored %s: %s snapshot %s -> %s (%s entries)\n' \
    "$group_id" "$tier" "$snapshot" "$dest" "$count"
done <"$work/steps"

printf 'restore complete; writers stay fenced until the old writer is revoked and the new epoch is verified\n'
