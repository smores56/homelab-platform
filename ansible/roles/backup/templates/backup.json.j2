{% set tiers = [] %}
{% for tier in backup_tiers %}
{% set _ = tiers.append({'name': tier.name, 'repository_root': tier.repository_root}) %}
{% endfor %}
{% set groups = [] %}
{% for group_id in backup_group_ids %}
{% set spec = backup_group_specs[group_id] %}
{% set _ = groups.append({'id': group_id, 'path': spec.path, 'cadence': spec.cadence, 'tiers': spec.tiers}) %}
{% endfor %}
{{ {
  'schema_version': backup_schema_version | int,
  'snapshot_dataset': backup_snapshot_dataset,
  'snapshot_root': backup_snapshot_root,
  'password_file': backup_password_file,
  'tiers': tiers,
  'groups': groups
} | to_nice_json }}
