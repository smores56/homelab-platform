[Unit]
Description=Back up the %i cadence from one recursive ZFS snapshot
Documentation=file:{{ backup_config_file }}
Wants=network-online.target
After=network-online.target
Requires=zfs-mount.service
After=zfs-mount.service
{% for unit in backup_crypt_units | default([]) %}
Requires={{ unit }}
After={{ unit }}
{% endfor %}
{% set data_mounts = (zfs_datasets | map(attribute='mountpoint') | list)
   + (backup_mounts | map(attribute='path') | list) %}
{% set repository_roots = backup_tiers | map(attribute='repository_root') | select('match', '^/') | list %}
RequiresMountsFor={{ (data_mounts + repository_roots) | unique | join(' ') }}
{% for mount in data_mounts | unique %}
AssertPathIsMountPoint={{ mount }}
{% endfor %}

[Service]
Type=oneshot
User=root
Group=root
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/data-plane/lib
Environment=RESTIC_CACHE_DIR={{ backup_cache_dir }}
EnvironmentFile=-{{ backup_r2_environment_file }}
ExecStart={{ backup_python }} {{ backup_program }} --config {{ backup_config_file }} --cadence %i
TimeoutStartSec={{ backup_service_timeout }}
UMask=0077
RuntimeDirectory={{ backup_snapshot_root | dirname | basename }}
RuntimeDirectoryMode=0750
# ZFS needs /dev/zfs, so devices are not privatised; everything else is.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths={{ backup_cache_dir }}
ReadWritePaths=-{{ backup_snapshot_root }}
# The runner imports the tested library from here; it is never writable.
ReadOnlyPaths=/opt/data-plane/lib
{% for tier in backup_tiers %}
{% if tier.repository_root is match('^/') %}
ReadWritePaths={{ tier.repository_root }}
{% endif %}
{% endfor %}
StandardOutput=journal
StandardError=journal
