{
  "listen": "0.0.0.0:8080",
  "deny_addresses": [],
  "logical_hosts": {
    "neuralwatt": {
      "scheme": "https",
      "host": "api.neuralwatt.com",
      "port": 443,
      "allow_private": false,
      "secret": "neuralwatt-api-key",
      "inject": {
        "kind": "bearer"
      }
    },
    "tinyfish": {
      "scheme": "https",
      "host": "api.search.tinyfish.ai",
      "port": 443,
      "allow_private": false,
      "secret": "tinyfish-api-key",
      "inject": {
        "kind": "header",
        "header": "X-Api-Key"
      }
    },
    "notify": {
      "scheme": "https",
      "host": "ntfy.sammohr.dev",
      "port": 443,
      "allow_private": false,
      "secret": "notify-token",
      "optional_secret": true,
      "inject": {
        "kind": "bearer"
      },
      "allow_methods": [
        "POST"
      ],
      "allow_paths": [
        "^/[a-z0-9_-]{1,64}$"
      ],
      "max_body_bytes": 4096
    },
    "loki": {
      "scheme": "http",
      "host": "loki-gateway.observability.svc.cluster.local",
      "port": 3100,
      "allow_private": true,
      "secret": "loki-gateway-token",
      "inject": {
        "kind": "bearer"
      },
      "headers": {
        "X-Scope-OrgID": "data"
      }
    },
    "memory": {
      "scheme": "http",
      "host": "memory-mcp.graphiti.svc.cluster.local",
      "port": 8182,
      "allow_private": true,
      "secret": "memory-mcp-token",
      "optional_secret": true,
      "inject": {
        "kind": "bearer"
      }
    },
    "self": {
      "scheme": "http",
      "host": "agent-control.tenant-apps.svc.cluster.local",
      "port": 8081,
      "allow_private": true,
      "path_prefix": "/self"
    },
    "cluster": {
      "scheme": "http",
      "host": "agent-control.tenant-apps.svc.cluster.local",
      "port": 8081,
      "allow_private": true,
      "path_prefix": "/cluster"
    },
    "status": {
      "scheme": "http",
      "host": "status-exporter.observability.svc.cluster.local",
      "port": 9101,
      "allow_private": true
    }
  }
}
