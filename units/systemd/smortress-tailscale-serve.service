[Unit]
# Declare the Tailscale Serve routes that front the loopback-published
# applications: the three core apps on their own root paths, plus one
# /apps/<name> path on 443 per reachable tenant app from the rendered plan.
# Serve state lives in tailscaled's state file, which is not a recovery group,
# so the routes are re-declared at every boot, and a route the plan no longer
# names is removed. Every route is Funnel-free: tailnet clients only.
#
# This unit needs an enrolled tailnet. Without one it fails visibly rather than
# skipping, because a host whose applications answer on no route is a fault, not
# a configuration choice.
Description=Declare Tailscale Serve routes for the applications
Requires=tailscaled.service
After=network-online.target tailscaled.service smortress-tailscale-up.service
Wants=network-online.target smortress-tailscale-up.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/tailscale-serve
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
