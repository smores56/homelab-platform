[Unit]
Description=Every six hours, reconcile a missed Brave browsing pass

[Timer]
# The path unit is the real trigger; this only closes a missed one. Six hours is
# long enough that a quiet browser does not rewrite the same generation all day and
# short enough that a broken watcher is visible within a day. Persistent, because a
# missed run is a gap in the replica.
OnCalendar=*-*-* 00/6:20:00
AccuracySec=1m
Persistent=true
Unit=smortress-agent-collect-brave.service

[Install]
WantedBy=timers.target
