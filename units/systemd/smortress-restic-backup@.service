[Unit]
# Driver for one Restic backend: %i is ssd, hdd or r2. It runs every recovery
# group for that backend, records each result independently, and only then
# exits non-zero if anything failed.
#
# Readiness is per dataset, not per unit: a failed zfs-ready@<dataset> must fail
# only that group's job. The unit therefore orders after every readiness
# instance and the script itself re-checks the exact dataset before touching it.
Description=Run due Restic backup jobs for the %i repository
After=zfs-ready@raw-files.service zfs-ready@raw-photos.service zfs-ready@raw-books.service zfs-ready@raw-music.service zfs-ready@raw-wallpapers.service zfs-ready@raw-git.service zfs-ready@raw-apps.service zfs-ready@raw-repo-archive.service zfs-ready@state-immich-postgres.service zfs-ready@state-immich-dumps.service zfs-ready@state-syncthing-config.service zfs-ready@state-opdshelf.service zfs-ready@state-caddy.service \
      zfs-ready@state-agent-local.service zfs-ready@state-agent-general.service zfs-ready@state-agent-model.service \
      smortress-restic-init.service \
      var-lib-restic-ssd.mount var-lib-restic-hdd.mount \
      sops-decrypt.service network-online.target
Wants=zfs-ready@raw-files.service zfs-ready@raw-photos.service zfs-ready@raw-books.service zfs-ready@raw-music.service zfs-ready@raw-wallpapers.service zfs-ready@raw-git.service zfs-ready@raw-apps.service zfs-ready@raw-repo-archive.service zfs-ready@state-immich-postgres.service zfs-ready@state-immich-dumps.service zfs-ready@state-syncthing-config.service zfs-ready@state-opdshelf.service zfs-ready@state-caddy.service \
      zfs-ready@state-agent-local.service zfs-ready@state-agent-general.service zfs-ready@state-agent-model.service \
      smortress-restic-init.service \
      var-lib-restic-ssd.mount var-lib-restic-hdd.mount network-online.target
Requires=sops-decrypt.service

[Service]
# No HOME under systemd; restic needs an explicit cache directory.
CacheDirectory=smortress-restic
Environment=RESTIC_CACHE_DIR=/var/cache/smortress-restic
Type=oneshot
ExecStart=/usr/libexec/smortress-restic-backup %i
# Safety net only: every restic, zfs and curl call has its own deadline in the
# script, which is what turns a hang into a recorded failure. This bound has to
# clear the worst single group rather than sit under it: a first r2 upload gets
# one attempt of 32400 s (RESTIC_DEADLINE_FIRST_R2 x RESTIC_ATTEMPTS_FIRST),
# plus 14400 s of repository maintenance and 3600 s of per-command slack. It
# stays under the 86400 s daily r2 schedule, so a run this net does kill is
# retried by the next daily timer instead of vanishing for a day.
TimeoutStartSec=50400
KillSignal=SIGTERM
TimeoutStopSec=120
