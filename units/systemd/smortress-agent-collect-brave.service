# One browsing pass: snapshot the live profile, then publish the copy.
#
# Two stages rather than two units for the same reason the calendar pass has two:
# the collector refuses a database that is still being written (a `-wal` or
# `-journal` beside it), and only one process knows how to take a consistent copy
# while the browser holds the file. Stage 1 is `apps/brave_ingest/snapshot.py`:
# SQLite's backup API against a read-only connection, and -- when the live artifact
# cannot be backed up that way -- a copy of `History` with its sidecars into a
# staging directory whose write-ahead log is folded in before anything is
# published. Either way the collector is handed one file with no sibling.
#
# `quarantine/brave/History` is the published copy, replaced by rename, so a
# collection never reads a half-written one. It is disposable: every pass replaces
# it, and the replica is what keeps history.
#
# Neither stage has a network. The provider half is `agent-brave.container`: it
# holds the chain membership and is the only process that talks to Brave's sync
# server, through the allowlist proxy on `agent-brave.network`. This unit reads a
# local file and writes the personal replica, so it needs no address at all --
# which is why it is not on any of the collectors' networks.
#
# The names it records are constants, not discovery: `--device smortress` is this
# host, the only one whose history is collected, and `--profile default` is the one
# headless profile `agent-brave.container` runs. Chromium's own profile name is
# `Default`; the collector's `profile` is the device-side label the replica is keyed
# by, and a second profile on this host would be a second label, not a second path.
#
# A refusal exits 3 and publishes nothing: a snapshot that could not be taken, a
# database that fails `integrity_check`, a replica that cannot be written. That is
# a failed unit on purpose -- the timer is the only signal that the replica stopped
# advancing, and a red unit is better than a generation that looks like the user
# deleted everything.
[Unit]
Description=Snapshot and collect Brave browsing history into the personal replica
Requires=zfs-ready@state-agent-local.service smortress-agent-config.service
After=zfs-ready@state-agent-local.service smortress-agent-config.service
# Nothing to snapshot before the browser has run once. A path or timer start in
# that window is skipped rather than reported as broken.
ConditionPathExists=/var/lib/agent/local/quarantine/brave-profile/Default/History

[Service]
Type=oneshot
UMask=0077
# Stage 1: the quiesced copy. The profile is read-only in here -- the backup API
# opens the source `mode=ro` so it never creates a sidecar beside the browser's
# file -- and the quarantine directory is the one writable mount.
ExecStart=/usr/bin/podman run --rm --replace --name smortress-agent-brave-snapshot \
  --network none \
  --read-only --cap-drop=all --security-opt no-new-privileges \
  --tmpfs /tmp:rw,size=64m --user 1000:1000 \
  --volume /var/lib/agent/local/quarantine/brave-profile:/profile:ro \
  --volume /var/lib/agent/local/quarantine/brave:/quarantine:z \
  --env PYTHONPATH=/usr/lib/agent-facade/libs:/usr/lib/agent-facade \
  --env PYTHONDONTWRITEBYTECODE=1 \
  --entrypoint python3 \
  ghcr.io/smores56/homelab-platform/agent-runtime@sha256:c6a92f491aad9f608ad8f412e44b76cfc9c547c26bdbb08c44760f62487b0134 \
  -m apps.brave_ingest.snapshot --database /profile/Default/History \
  --out /quarantine/History
# Stage 2: publish what the snapshot wrote. The copy is mounted read-only here, so
# the collector cannot create the sidecar it would then refuse, and the replica is
# the only writable mount. `deleted` stays 0: retention expiry, a user deleting
# history and a profile being recreated all look the same from here, so a vanished
# table is carried forward with a reason instead of being tombstoned.
ExecStart=/usr/bin/podman run --rm --replace --name smortress-agent-collect-brave \
  --network none \
  --read-only --cap-drop=all --security-opt no-new-privileges \
  --tmpfs /tmp:rw,size=16m --user 1000:1000 \
  --volume /var/lib/agent/local/quarantine/brave:/quarantine:ro \
  --volume /var/lib/agent/local/replica:/replica:z \
  --env PYTHONPATH=/usr/lib/agent-facade/libs:/usr/lib/agent-facade \
  --env PYTHONDONTWRITEBYTECODE=1 \
  --entrypoint python3 \
  ghcr.io/smores56/homelab-platform/agent-runtime@sha256:c6a92f491aad9f608ad8f412e44b76cfc9c547c26bdbb08c44760f62487b0134 \
  -m data_plane.collectors.raw --root /replica/brave \
  brave --database /quarantine/History --device smortress --profile default
Restart=no
# A snapshot of a large history and a full table dump: the limit is generous
# because a slow one is still a complete one, and neither stage retries.
TimeoutStartSec=600
