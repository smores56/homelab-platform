[Unit]
# The local SELinux module sudo's touch factor needs (design #767, T8).
# pam_rssh connects to the ssh-agent socket sshd forwards, which OpenSSH >= 10.1
# creates under ~/.ssh/agent labelled ssh_home_t, and the targeted policy grants
# sudo_t no access to it. Without this module every escalation logs an AVC and
# falls back to the password, which fails closed but defeats the gesture.
#
# The policy store lives in /etc/selinux and /var/lib/selinux, which bootc never
# reconciles, so shipping a new .pp is not loading it: this unit runs on every
# boot and the script decides from the file's digest whether there is anything to
# do. ConditionSecurity= keeps a host with SELinux disabled from failing a boot
# over a module it cannot use.
Description=Load the local SELinux policy that lets sudo reach the forwarded agent
ConditionSecurity=selinux
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/selinux-sudo-rssh-load
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
