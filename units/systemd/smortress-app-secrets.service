[Unit]
# Turn the decrypted application secrets into Podman secrets. The images that
# need a value in their environment rather than in a file (OPDShelf reads
# ADMIN_PASSWORD only from the environment) get it this way; the value comes
# from the decrypted file, never from a unit file, argv or the image.
#
# Requires= is deliberate: a failed decrypt must not publish an empty secret.
# There is no Condition here on purpose: skipping would make every container that
# declares a secret skip too, and a host that starts nothing because a ciphertext
# is missing has to say so on the unit that owns the omission.
Description=Create the Podman secrets the application Quadlets declare
Requires=sops-decrypt.service
After=sops-decrypt.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/app-secrets
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
