[Unit]
# The smores account's password hash is image ciphertext, not an operator file the
# installer has to carry: bootc never reconciles /var, so /etc/shadow would stay
# whatever the install left there, and a reinstall would silently restore an old
# password. This unit is the boot half of the pair; the install half is
# scripts/render-ignition.sh, which reads the same ciphertext.
#
# Requires= is deliberate, as on every consumer of a decrypted secret: a failed
# decrypt must not leave the account on the previous password while the host
# looks reconciled. ConditionPathExists= covers the one case Requires= cannot:
# without the manifest line nothing writes the file, the decrypt unit succeeds
# and this unit has nothing to apply, so it skips instead of failing a boot over
# a secret the manifest no longer lists.
Description=Re-apply the smores account password hash from ciphertext
Requires=sops-decrypt.service
After=sops-decrypt.service
ConditionPathExists=/run/smortress/secrets/smores-password-hash.yaml

[Service]
Type=oneshot
RemainAfterExit=yes
# /etc/shadow is written here, so ProtectSystem=strict cannot apply; the guard and
# the single usermod exec live in the script, which keeps the hash out of this
# unit file and out of every argv except usermod's own.
UMask=0077
PrivateTmp=yes
ExecStart=/usr/libexec/smortress-password
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
