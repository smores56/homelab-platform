[Unit]
Description=Keep or roll back the deployment this host just booted
# Greenboot's ordering, and the reason the receiver can promise a rollback: the
# gate runs late in boot (every service the health checks ask about has been
# started) and the boot is not declared complete until it has recorded or
# rolled back the deployment. It runs on every boot, not only after a deploy, so
# an interrupted apps apply is reconciled too.
Before=boot-complete.target
After=multi-user.target
After=sops-decrypt.service network-online.target
After=smortress-tailscale-serve.service
# systemd rejects a template glob in an ordering dependency ("Failed to add
# dependency on zfs-ready@*.service"), and After=multi-user.target already orders
# this unit after every readiness unit the image enables. The apps dataset is the
# one the health gate mounts-checks, so its instance is named outright.
After=zfs-ready@raw-apps.service
# Wants, not Requires: a dependency that failed is exactly what the health gate
# is there to judge, and a unit skipped for a failed dependency would leave a
# broken deployment recorded as landed. The GRUB counter is the net under this.
Wants=sops-decrypt.service zfs-ready@raw-apps.service network-online.target
Wants=smortress-tailscale-serve.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/smortress-boot-gate
# The bounded apps revert (1200 s), the health budget (300 s) and one bounded
# rollback (900 s), so a wedged tenant helper or `bootc` cannot hold the boot for
# ever. The revert bound is shorter than an apply's: it pulls no image.
TimeoutStartSec=2700
UMask=0077
User=root
# The deploy lock's own directory, never /run/smortress: the gate takes the same
# lock the drain does, and the secrets must stay read-only. Preserve=yes so a
# hand-run command's lock inode survives this oneshot's own cleanup.
RuntimeDirectory=smortress-deploy
# bootc creates a temporary containers-storage at /run/bootc/storage while it
# stages a pull; ProtectSystem=strict leaves /run read-only, so PID 1 creates
# that one directory writable instead of opening all of /run.
RuntimeDirectory=bootc
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes

# The gate writes the deploy records and the grubenv, and `bootc rollback --apply`
# writes the ostree deployment it switches to. Nothing else is writable: a
# compromised gate cannot rewrite a unit, a Quadlet or the tenant's data, and the
# decrypted secrets under /run/smortress stay read-only. A bootc mutation needs
# `/sysroot` itself, not just `/sysroot/ostree`: bootc remounts /sysroot writable
# before it writes anything, and that remount is what ProtectSystem=strict turns
# into "Initializing storage: Read-only file system". `bootc rollback --apply`
# takes the same path as a switch.
ProtectSystem=strict
ReadWritePaths=/var/lib/homelab/deploy
ReadWritePaths=/boot
ReadWritePaths=-/sysroot/ostree
# `bootc rollback --apply` runs the same SELinux install_t probe the switch does,
# so the gate needs the same private scratch as the drain.
ReadWritePaths=/tmp
ReadWritePaths=/var/tmp
# A gate on a boot after an interrupted apps apply reverts it through
# deploy-apps, which restores the tenant plan here and, as the tenant via
# runuser, its units and secret values under /var/home/apps.
ReadWritePaths=/var/lib/homelab/apps
# ProtectHome=read-only would make the tenant home read-only for the runuser
# child and fail the revert, so exactly that home is re-opened; /root stays
# protected.
ReadWritePaths=/var/home/apps
# Rootless podman and `systemctl --user` write their runtime state and private
# socket here; no session bus is needed.
ReadWritePaths=/run/user
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
