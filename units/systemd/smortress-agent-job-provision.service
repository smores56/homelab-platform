[Unit]
# The shell runners' rootless prerequisites and the uid-keyed egress table
# (SDLC #715, T5 of #702). systemd-sysusers creates the accounts; this gives each
# a subuid/subgid range and the general runner its ACL on /var/srv/git, and loads
# the firewall before any job can start. A boot where the ruleset does not load
# leaves the runners with no table, which is why the dispatcher reloads it and
# refuses to launch when it cannot: the job path is fail-closed even if this unit
# is skipped.
Description=Provision the agent shell runners for rootless Podman
DefaultDependencies=no
Wants=systemd-sysusers.service local-fs.target zfs-ready@raw-git.service
After=systemd-sysusers.service local-fs.target zfs-ready@raw-git.service
Requires=systemd-sysusers.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/agent-job-provision

[Install]
WantedBy=sysinit.target
