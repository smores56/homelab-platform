[Unit]
Description=Dump the Immich database before the daily offsite snapshot

[Timer]
# 23:00 UTC: the dump completes before the midnight R2 run, so the daily offsite
# snapshot always carries a dump from the same day. Not persistent: a missed
# dump must not fire during a restore drill.
OnCalendar=*-*-* 23:00:00
AccuracySec=1m
Persistent=false
Unit=smortress-immich-dump.service

[Install]
WantedBy=timers.target
