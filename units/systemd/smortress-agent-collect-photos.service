[Unit]
# One photos pass: the library as it is on disk right now becomes a generation.
#
# One stage, no network and no secret, like the vault collectors: a photo library
# is a directory tree, the collector is the only process, the library is mounted
# read-only and the replica tree is the one writable mount. Being on no network
# is what makes the pass harmless to repeat hourly.
#
# The pass only stats: the generation carries identifiers, titles, timestamps and
# the size and format of each file, and the media bytes stay on the photo
# dataset. Unchanged objects are hard-linked from the previous generation, so a
# run that changes one photo costs one object.
#
# A refusal exits 3 and publishes nothing. That is a failed unit on purpose: a
# library that vanished, or one over the collector's object limit, needs a human,
# and the timer is the only signal that the replica stopped advancing.
Description=Publish the photo library into the personal replica
Requires=zfs-ready@state-agent-local.service zfs-ready@raw-photos.service
After=zfs-ready@state-agent-local.service zfs-ready@raw-photos.service
# Nothing to publish before the library is present; until then the timed run is
# skipped rather than reported as broken.
ConditionPathExists=/srv/photos

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/podman run --rm --replace --name smortress-agent-collect-photos \
  --network none \
  --read-only --cap-drop=all --security-opt no-new-privileges \
  --tmpfs /tmp:rw,size=16m --user 1000:1000 \
  --volume /srv/photos:/entities:ro \
  --volume /var/lib/agent/local/replica:/replica:z \
  --env PYTHONPATH=/usr/lib/agent-facade/libs:/usr/lib/agent-facade \
  --env PYTHONDONTWRITEBYTECODE=1 \
  --entrypoint python3 \
  ghcr.io/smores56/homelab-platform/agent-runtime@sha256:baf78568d489f190946e77d0929fa288689415dff202e762857dfeda24de9e5a \
  -m data_plane.collectors.raw --root /replica/photos \
  photos --entities /entities
Restart=no
# A library of many thousand assets, each stat'ed once; the walk is metadata I/O
# and one JSON write per object.
TimeoutStartSec=900
