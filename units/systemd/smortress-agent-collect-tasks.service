[Unit]
# One tasks pass: todo.txt and done.txt become one committed state.
#
# Same shape as the notes pass and for the same reason: two files on disk, no
# provider, no network, no secret. The directory is mounted read-only and the
# replica tree is the only writable mount.
#
# A refusal exits 3 and publishes nothing. The collector refuses a directory that
# holds neither file, so a mistyped or unmounted path stops the replica advancing
# instead of committing an empty list that carries every task away.
Description=Publish the todo.txt list into the personal replica
Requires=zfs-ready@state-agent-local.service
After=zfs-ready@state-agent-local.service
ConditionPathExists=/srv/files/notes

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/podman run --rm --replace --name smortress-agent-collect-tasks \
  --network none \
  --read-only --cap-drop=all --security-opt no-new-privileges \
  --tmpfs /tmp:rw,size=16m --user 1000:1000 \
  --volume /srv/files/notes:/entities:ro \
  --volume /var/lib/agent/local/replica:/replica:z \
  --env PYTHONPATH=/usr/lib/agent-facade/libs:/usr/lib/agent-facade \
  --env PYTHONDONTWRITEBYTECODE=1 \
  --entrypoint python3 \
  ghcr.io/smores56/homelab-platform/agent-runtime@sha256:a2097dc2f54142b75137779c91f2e90956a01687cdfd2424685d748c3669baa1 \
  -m data_plane.collectors.raw --root /replica/tasks \
  tasks --entities /entities
Restart=no
# Two small files; the timeout is the net under a frozen podman, not a budget.
TimeoutStartSec=120
