[Unit]
Description=Five-minute dead-man beat for the deploy receiver

[Timer]
# The check's own period is five minutes, so the beat fires on the minute rather
# than coalescing with other timers by up to a minute: a beat that landed a minute
# late would leave a six-minute gap in a five-minute check and page for a host that
# is healthy.
OnCalendar=*-*-* *:0/5:00
AccuracySec=1s
Unit=smortress-deploy-heartbeat.service

[Install]
WantedBy=timers.target
