[Unit]
Description=Quarter-hour poll that deploys whatever has been published

[Timer]
# Every fifteen minutes, and not a window: the poll is the only trigger left once
# the receiver retires (design #1010), so the interval is the whole of the delay
# between a merge and the deployment it becomes. One run is one anonymous API call
# per repository, cached for 120 s, which is what keeps the cadence inside the
# budget.
OnCalendar=*-*-* *:0/15:00
AccuracySec=1min
# Not persistent: a host that was off is not owed a deploy on the way up. Firing
# every missed tick at boot is a reboot nobody scheduled, which is the behaviour
# this timer replaced.
Persistent=false
Unit=smortress-deploy-poll.service

[Install]
WantedBy=timers.target
