[Unit]
# Enroll this host in the tailnet with Tailscale SSH enabled, so tailnet
# devices reach it without managing authorized_keys. Tailnet ACLs decide who
# may connect; sshd stays key-only as the fallback path.
#
# The auth key is optional. Without it the unit is skipped and the operator runs
# `tailscale up --ssh --hostname smortress` once by hand. With it, the ciphertext
# in /etc/smortress/secrets decrypts to /run at boot as `authkey: tskey-...`.
# Requires= is deliberate: a failed decrypt must not run `tailscale up` with an
# empty key. The key reaches the command through a temporary file, never argv.
Description=Enroll smortress in the tailnet with SSH
Requires=firewalld.service tailscaled.service sops-decrypt.service
Wants=network-online.target
After=network-online.target firewalld.service tailscaled.service sops-decrypt.service
ConditionPathExists=/run/smortress/secrets/tailscale.yaml
ConditionPathExists=!/var/lib/smortress/tailscale-enrolled

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'umask 077; k=$(mktemp); sed -n "s/^authkey:[[:space:]]*//p" /run/smortress/secrets/tailscale.yaml >"$k"; /usr/bin/tailscale up --ssh --hostname=smortress --auth-key="file:$k"; rc=$?; rm -f "$k"; exit $rc'
ExecStart=/usr/bin/install -d -m 0700 /var/lib/smortress
ExecStart=/usr/bin/touch /var/lib/smortress/tailscale-enrolled
ExecStart=/usr/libexec/access-lockdown

[Install]
WantedBy=multi-user.target
