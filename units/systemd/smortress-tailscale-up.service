[Unit]
# Enroll this host in the tailnet. Tailscale SSH is off (design #748, #767): sshd
# answers the tailnet itself, through firewalld and the login key, and
# `tailscale ssh` would instead start the shell outside PAM and, under SELinux,
# in unconfined_service_t. The Serve routes stay on the tailnet and need no SSH.
#
# The auth key is optional. Without it the unit is skipped and the operator runs
# `tailscale up --hostname smortress` once by hand. With it, the ciphertext in
# /etc/smortress/secrets decrypts to /run at boot as `authkey: tskey-...`.
# Requires= is deliberate: a failed decrypt must not run `tailscale up` with an
# empty key. The key reaches the command through a temporary file, never argv.
#
# Re-asserting the preference is not this unit's job: it is gated on the
# enrollment marker and stops running after the first boot, while tailscaled
# keeps the preference in its state file. `tailscale set --ssh=false` lives in
# smortress-tailscale-ssh-off.service for that reason.
Description=Enroll smortress in the tailnet
Requires=firewalld.service tailscaled.service sops-decrypt.service
Wants=network-online.target
After=network-online.target firewalld.service tailscaled.service sops-decrypt.service
ConditionPathExists=/run/smortress/secrets/tailscale.yaml
ConditionPathExists=!/var/lib/homelab/tailscale-enrolled

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'umask 077; k=$(mktemp); sed -n "s/^authkey:[[:space:]]*//p" /run/smortress/secrets/tailscale.yaml >"$k"; /usr/bin/tailscale up --hostname=smortress --auth-key="file:$k"; rc=$?; rm -f "$k"; exit $rc'
# -m 0711 matches tmpfiles: the age identity, the applications' state and this
# unit's enrollment marker live under /var/lib/homelab, and nothing inside may be
# group- or world-accessible.
ExecStart=/usr/bin/install -d -m 0711 /var/lib/homelab
ExecStart=/usr/bin/touch /var/lib/homelab/tailscale-enrolled
ExecStart=/usr/libexec/access-lockdown

[Install]
WantedBy=multi-user.target
