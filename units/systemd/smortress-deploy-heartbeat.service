[Unit]
Description=Ping the deploy check when the deploy queue is moving
Requires=sops-decrypt.service
After=sops-decrypt.service
After=systemd-tmpfiles-setup.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/deploy-heartbeat
# The ping is bounded to 10 s; this is the net under a run that hangs anyway, and
# it has to stay well inside the timer's own period.
TimeoutStartSec=120
UMask=0077
User=root
# Read-only apart from the journal line it appends: the heartbeat must not be able
# to touch the queue it is judging.
ProtectSystem=strict
ReadWritePaths=/var/lib/homelab/deploy
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
