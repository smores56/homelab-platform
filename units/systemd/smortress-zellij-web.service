[Unit]
# The web terminal (#954): zellij's own web server on loopback, which Serve
# fronts as svc:terminal (scripts/tailscale-serve.sh). The socket directory is
# the one every SSH login resolves (dotfiles, env.d/20-zellij-socket.sh), so a
# browser attaches to the sessions an SSH client started and starts sessions an
# SSH client can attach to. tmpfiles creates it at boot; a system unit cannot
# reach $XDG_RUNTIME_DIR/zellij, which is the directory an SSH login would use.
#
# It runs as the owner and hides nothing: the zellij binary and its config come
# from mise in that home, the token database is ~/.local/share/zellij/tokens.db,
# and a pane's programs want writable /tmp. Therefore no ProtectHome and no
# PrivateTmp, and no NoNewPrivileges either: the panes are interactive shells
# where sudo is the point, and the flag would block every setuid program in them.
#
# The server is a plain child, and zellij's session daemons are its children: a
# restart has to leave them running, or reconnecting a browser would end the work
# it was attached to.
Description=zellij web terminal
After=local-fs.target systemd-tmpfiles-setup.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
User=smores
WorkingDirectory=/var/home/smores
# Every pane inherits this environment, and fish and zellij are both mise tools:
# without the shims ahead of the system path, each program a pane starts is
# missing, beginning with the default shell.
Environment=PATH=/var/home/smores/.local/share/mise/shims:/var/home/smores/.local/bin:/usr/local/bin:/usr/bin
Environment=ZELLIJ_SOCKET_DIR=/run/zellij
Environment=TERM=xterm-256color
ExecStart=/var/home/smores/.local/share/mise/shims/zellij web --ip 127.0.0.1 --port 8082
# The `-` prefix is load-bearing: `attach --create-background` exits 1 when the
# session already exists, which is the healthy case on every boot after the first.
ExecStartPost=-/var/home/smores/.local/share/mise/shims/zellij attach main --create-background
Restart=always
RestartSec=5
# The default kill mode would take every session daemon with the server on each
# restart. `process` signals only the server, the same way a terminal client
# disconnecting leaves the session alive; a unit stop therefore leaves panes.
KillMode=process

[Install]
WantedBy=multi-user.target
