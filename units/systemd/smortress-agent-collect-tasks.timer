[Unit]
Description=Hourly, publish the todo.txt list into the personal replica

[Timer]
# Hourly and off the notes pass, so two directory walks never overlap. A task
# list is edited by a human, and this one is a two-file read. Persistent,
# because a missed run is a gap.
OnCalendar=*-*-* *:25:00
AccuracySec=1m
Persistent=true
Unit=smortress-agent-collect-tasks.service

[Install]
WantedBy=timers.target
