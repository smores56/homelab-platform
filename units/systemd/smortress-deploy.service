[Unit]
Description=Drain the deploy queue
# The drain reads the decrypted secrets (deploy ping URL, webhook secret) and
# writes state.json, so it needs the decrypt step finished, not just started.
Requires=sops-decrypt.service
After=sops-decrypt.service
# The state tree and the queue are tmpfiles' to create; ordering after the setup
# step keeps the first drain of a boot from finding no directory at all.
After=systemd-tmpfiles-setup.service
After=network-online.target
# A wedged drain must not hold the shutdown path.
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/deploy-drain
# The whole-drain bound. Every individual external command has its own deadline
# (T2 onward); this is the net that stops one that hangs anyway from leaving the
# unit active for ever with the deploy lock held.
TimeoutStartSec=7200
UMask=0077
User=root
# The snapshot gate (T3) runs the Restic driver as a child, and that driver keeps
# its cache here; the CacheDirectory makes the directory exist and writable in
# the unit's namespace, which ProtectSystem=strict would otherwise not give it.
CacheDirectory=smortress-restic
Environment=RESTIC_CACHE_DIR=/var/cache/smortress-restic

# state.json, the queue and the journal are the drain's own writes. The lock
# lives in /run, which protectsystem=strict also covers, so it is listed too.
# The snapshot gate (T3) adds the plane's state tree and the two local
# repositories: it backs a stale restore unit up before a platform reboot. The
# `-` prefix keeps the unit startable when the 970 is absent -- the gate falls
# back to the HDD, which is the whole reason the mount is `nofail`.
ProtectSystem=strict
ReadWritePaths=/var/lib/homelab/deploy
ReadWritePaths=/run/smortress
ReadWritePaths=/var/lib/homelab/restic
ReadWritePaths=-/var/lib/restic/ssd
ReadWritePaths=-/var/lib/restic/hdd
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
