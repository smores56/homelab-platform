[Unit]
Description=Hourly, publish the Markdown vault into the personal replica

[Timer]
# Hourly: a note is edited by a human at an unpredictable time, the pass is a
# directory walk with hard-linked reuse, and an hour is the staleness a reader
# can be expected to tolerate. Persistent, because a missed run is a gap.
OnCalendar=*-*-* *:20:00
AccuracySec=1m
Persistent=true
Unit=smortress-agent-collect@notes.service

[Install]
WantedBy=timers.target
