[Unit]
# The tenant's egress boundary is otherwise static, but the ruleset names the
# apps account and nft resolves that name at load time, so systemd-sysusers must
# have created the account first or nft aborts. It must be in force before any
# tenant container starts, and before Serve can route to one.
Description=Drop apps-tenant egress to LAN, tailnet, host and metadata destinations
DefaultDependencies=no
Wants=systemd-sysusers.service local-fs.target
After=systemd-sysusers.service local-fs.target
# Before logind: the rule must be in force before a lingering user manager can
# start a tenant container.
Conflicts=shutdown.target
Before=systemd-logind.service shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The vendor path, not /etc: bootc merges the image's /etc into the host's, so
# an /etc copy is editable into drift (a stale tenant uid) or deletable outright
# (no ruleset at the next start, and the tenant falls through to `policy
# accept`). /usr/etc is the image's own copy and cannot be either.
ExecStart=/usr/bin/nft -f /usr/etc/nftables/smortress-apps.nft

[Install]
WantedBy=sysinit.target
