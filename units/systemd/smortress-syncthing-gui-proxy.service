[Unit]
# The loopback proxy in front of the Syncthing GUI (design #897, T1).
#
# Syncthing's GUI refuses a Host header it does not expect and Tailscale Serve
# forwards the client's Host unchanged, so `svc:sync` cannot reach the GUI unless
# the header is the one the GUI trusts. The host's answer used to be
# `insecureSkipHostcheck`, which turns the check off for every caller instead of
# teaching the GUI one name; since T2 the bypass is off and
# `smortress-syncthing-hostcheck.service` is what keeps it off. Caddy answers on
# 127.0.0.1:8385, rewrites Host to
# 127.0.0.1:8384, and forwards, so the GUI keeps its check and `svc:sync` targets
# the proxy (scripts/tailscale-serve.sh) rather than the GUI.
#
# `syncthing.service` is the Quadlet-generated unit of
# units/quadlet/syncthing.container -- `ContainerName=smortress-syncthing` names
# the container, not the unit, so the unit is `syncthing.service`. Ordering only:
# a GUI that is not up yet costs a 502 through the proxy, and Restart= below is
# what covers this unit failing, so Wants/Requires would only make the proxy's
# failure take the GUI with it.
#
# Requires= the host-check enforcement (T2): the GUI trusts one address only
# because that bypass is off, so a proxy in front of a GUI that still trusts any
# Host would be the exposure the split was meant to end. A failed enforcement
# therefore takes the route down instead of trusting a setting nobody verified.
#
# Not in deploy-units.txt on purpose: a proxy that is not running is a broken
# route, not a host that rolled back onto an image that deployed cleanly.
Description=Loopback proxy in front of the Syncthing GUI
After=network.target syncthing.service smortress-syncthing-hostcheck.service
Requires=smortress-syncthing-hostcheck.service
Wants=network.target

[Service]
Type=simple
# The account the Fedora package creates. The proxy only ever reads and forwards,
# and 8385 is above 1024, so the unit grants no capability at all -- the two empty
# assignments below are the statement of that, not a default left to the reader.
User=caddy
Group=caddy
# Validate before listening: a Caddyfile that does not parse is a build failure
# (bootc/server/Containerfile validates it too), and at boot this turns a unit
# that would crash-loop into one that fails with Caddy's own message.
ExecStartPre=/usr/bin/caddy validate --config /usr/share/smortress/syncthing-gui.Caddyfile --adapter caddyfile
ExecStart=/usr/bin/caddy run --config /usr/share/smortress/syncthing-gui.Caddyfile --adapter caddyfile
# Cleared, not repointed: the Caddyfile sets `admin off`, so there is no API for
# `caddy reload` to reach and a successful-looking reload would be a lie.
ExecReload=
# The GUI is the owner's file browser; a proxy that dies and stays down is an
# outage nobody sees until they open it.
Restart=on-failure
RestartSec=5s
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
# TCP to the tailnet client and the GUI, and AF_NETLINK for the interface lookup
# Caddy does once at start. AF_UNIX stays because systemd's own notify and the Go
# runtime's DNS resolution use it; neither is a network route.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
