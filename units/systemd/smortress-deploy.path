# A request in the queue is the only trigger: `DirectoryNotEmpty` fires on the
# first file, and every later file re-fires it. The drain runs as a oneshot and
# rescans before exiting, so a request that lands while it is finishing is still
# drained by the same run instead of waiting for the next event.
#
# The directory is created by tmpfiles at boot; a missing queue simply never
# triggers, and the heartbeat's queue scan is what reports one unusable.
[Unit]
Description=Drain the deploy queue when a request lands

[Path]
DirectoryNotEmpty=/var/lib/homelab/deploy/queue
Unit=smortress-deploy.service

[Install]
WantedBy=paths.target
