# The Immich API and web UI. It is served at the root of a Tailscale Serve
# HTTPS port, never on a subpath: Immich does not support subpath mounting, so
# the path has to stay a root. `tailscale serve` fronts 127.0.0.1:2283 and
# forwards the original Host, which the mobile app and the web client need.
[Unit]
Description=Immich API and web UI (photos recovery group)
Requires=zfs-ready@photos.service sops-decrypt.service smortress-app-secrets.service
After=network-online.target zfs-ready@photos.service sops-decrypt.service smortress-app-secrets.service immich-postgres.service immich-valkey.service
Wants=network-online.target immich-postgres.service immich-valkey.service

[Container]
Image=ghcr.io/smores56/homelab-platform/immich-server@sha256:c716dc20f957aafd89fa9d284a2ec63e25c9e2d8d8e87c6197d540a3dce237db
ContainerName=smortress-immich-server
Network=immich.network
User=1000:1000
Secret=immich-db-password,type=mount,target=/run/secrets/immich-db-password,uid=1000,gid=1000,mode=0400
Environment=DB_HOSTNAME=smortress-immich-postgres
Environment=DB_PORT=5432
Environment=DB_USERNAME=immich
Environment=DB_DATABASE_NAME=immich
Environment=DB_PASSWORD_FILE=/run/secrets/immich-db-password
Environment=REDIS_HOSTNAME=smortress-immich-valkey
Environment=REDIS_PORT=6379
Environment=IMMICH_MACHINE_LEARNING_URL=http://smortress-immich-machine-learning:3003
Environment=IMMICH_MEDIA_LOCATION=/data/library
Environment=TZ=UTC
Volume=/var/tank/photos:/data:z
PublishPort=127.0.0.1:2283:2283
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=on-failure
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
