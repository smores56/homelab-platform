# The personal Mirage virtual terminal (SDLC #979, T1).
#
# This is the agent's shell and filesystem: one daemon, one workspace, and the
# host directories the workspace config names. It joins agent-local.network and
# publishes nothing, so it has no route off the host and no host port; the
# personal gateway reaches it by container name on the bridge.
#
# The token is the whole authentication story, and it is not in this file. The
# daemon takes it as `MIRAGE_AUTH_TOKEN` from the environment and has no `_FILE`
# variant, while Podman's `type=env` secret would carry the ciphertext's trailing
# newline into a comparison that never matches -- the same trap the gateway's
# `API_SERVER_KEY` hits. smortress-agent-config.service therefore writes
# `mirage.env` into the dataset with the newline stripped, and the unit reads it
# with `EnvironmentFile=`.
#
# The dataset is state/agent-local, beside the gateway, not a new one: the
# personal plane is one recovery unit (T8), and the workspace's own state --
# sessions, the ssh host key, snapshots -- belongs in the same point in time as
# the gateway's. T9's decommission moves nothing here.
#
# `/srv/files` is mounted writable because the workspace config is what makes the
# vault read-only; a volume that were read-only would take the todos write path
# with it. `/state/feed` is written by the host watcher
# (smortress-agent-todos-watch.service) and read by the agent.
#
# There is no `PublishPort=`: nothing outside agent-local.network needs this, and
# a published port is a second thing to reason about for no reach.
[Unit]
Description=Mirage virtual terminal, personal deployment (no egress)
Requires=zfs-ready@state-agent-local.service zfs-ready@raw-files.service sops-decrypt.service smortress-agent-config.service
After=network-online.target zfs-ready@state-agent-local.service zfs-ready@raw-files.service sops-decrypt.service smortress-agent-config.service agent-local-network.service
Wants=network-online.target

[Container]
Image=ghcr.io/smores56/homelab-platform/mirage@sha256:c284a9156f2da1fe0835c6cf49c319f05739249af289b9ebdd85168b6ab660f5
ContainerName=smortress-mirage-personal
Network=agent-local.network
User=1000:1000
EnvironmentFile=/var/lib/agent/local/mirage.env
Environment=MIRAGE_HOME=/state
Environment=MIRAGE_DAEMON_PORT=8765
Environment=MIRAGE_PROXY_PORT=18010
Environment=MIRAGE_WORKSPACE_ID=personal
Environment=MIRAGE_WORKSPACE_CONFIG=/etc/mirage/workspace.yaml
Environment=TZ=UTC
Volume=/var/lib/agent/local/mirage:/state:z
Volume=/srv/files:/srv/files:z
Volume=/etc/smortress/mirage/personal.yaml:/etc/mirage/workspace.yaml:ro
ReadOnly=true
Tmpfs=/tmp:rw,size=64m
NoNewPrivileges=true
DropCapability=ALL

[Service]
# 143 is SIGTERM, which a deliberate stop sends: not a failure.
SuccessExitStatus=143
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
