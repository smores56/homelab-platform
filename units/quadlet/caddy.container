# The tailnet name service's terminator (design #834, task #845).
#
# Serve forwards the agent UI Service's tcp/443 to 127.0.0.1:9443, so this is the
# process that answers the TLS handshake for `assistant.sammohr.dev` and proxies
# the request to the personal web UI. The certificate is publicly trusted and
# issued over DNS-01, because nothing public may reach a tailnet VIP and the
# edge's 443 already belongs to Immich and OPDShelf.
#
# Network=host is the loopback contract, not a convenience: Serve's forward
# targets 127.0.0.1 on the host, and a published container port binds some other
# loopback path -- netavark's DNAT and firewalld's zone both sit in between, and
# the forward would answer on a port nothing listens on. Nothing is published and
# nothing binds a wildcard (`bind 127.0.0.1` in the Caddyfile), so the tailscale0
# zone stays the only ingress and Firewalld needs no port here.
#
# The data directory is a dataset because Caddy keeps the ACME account in it, and
# the account id is what a later order resumes with. A /var/lib path with no
# dataset would be shadowed the moment the dataset mounts, and Caddy would
# register a second account for a zone that is already validated.
#
# The Caddyfile is mounted read-only from /usr/share/smortress, the path bootc
# updates with the deployment; /etc is merged once, so a site added by a later
# image would never reach an existing host. (The egress containers mount theirs
# from /etc because that policy predates this rule.)
#
# Deliberately absent from deploy-units.txt: a certificate that cannot be issued
# is a token or a zone fault, and rolling the OS image back fixes neither, while
# a listed unit that is down rolls back every healthy deployment.
[Unit]
Description=TLS terminator for the tailnet name service
Requires=zfs-ready@state-caddy.service sops-decrypt.service smortress-app-secrets.service
After=network-online.target zfs-ready@state-caddy.service sops-decrypt.service smortress-app-secrets.service
Wants=network-online.target

[Container]
Image=ghcr.io/smores56/homelab-platform/caddy@sha256:77d85e665ca9e966d8db933e56fd646968dedfcb487f0dd7e5ab9d136e1830ca
ContainerName=smortress-caddy
Network=host
# uid 1000 is what a state dataset root belongs to, so the account and
# certificate files land owned by the process that rewrites them. The image has no
# passwd entry for it; that is fine for a numeric uid, and the listener is above
# 1024 so nothing needs a capability.
User=1000:1000
# The image's entrypoint runs `caddy run --config /etc/caddy/Caddyfile`; the Exec
# below is that same invocation plus the token. The secret is mounted, not copied
# into the environment: Podman's `type=env` passes the decrypted bytes verbatim,
# trailing newline included, and the Cloudflare provider rejects that with
# "appears invalid" instead of trimming it. Command substitution strips the
# trailing newline, which is the whole difference.
Volume=/usr/share/smortress/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=/var/lib/caddy:/data:z
Secret=cloudflare-acme-token
Exec=/bin/sh -c 'exec env CF_API_TOKEN="$(cat /run/secrets/cloudflare-acme-token)" caddy run --config /etc/caddy/Caddyfile'
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=on-failure
# 143 is SIGTERM, which a deliberate stop sends: not a failure.
SuccessExitStatus=143
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
