# The pinned local model server for the personal deployment: llama.cpp on the
# GPU, reachable only from agent-local.network. No PublishPort and no other
# network: the only client is the local gateway, by container name.
#
# `-c 65536` is a floor imposed by the runtime, not a tuning choice. Hermes
# refuses a model whose context window is under 64,000 tokens ("below the
# minimum 64,000 required by Hermes Agent"), so the server is started well above
# the model's native 8,192 and the gateway config pins the same number
# (bootc/server/rootfs/etc/smortress/agent/local-config.yaml). Raising one without the
# other is how the gateway stops admitting the model.
#
# The model file is fetched by hand into the state/agent-model dataset
# (hosts/server/runbook.md, "Fetch the pinned model") and mounted read-only: it is a 4.7 GiB
# artefact that is re-downloadable, so it is deliberately in no backup unit.
#
# GPU access is two directives, both needed: `AddDevice=nvidia.com/gpu=all`
# names the device, and `SecurityLabelType=nvidia_container_t` is the SELinux
# type the NVIDIA device nodes carry -- with the default container label the
# process gets NVML "Insufficient Permissions" instead of a GPU. The device name
# resolves through the CDI spec that smortress-nvidia-cdi.service generates at
# boot, which is why this unit is ordered after it.
#
# `User=1000:1000` follows the platform convention, and the state/agent-* datasets
# are owned by uid 1000 for it. The runtime image (agent-runtime) drops privileges
# to uid 10000 internally, which is *not* honoured here on purpose: a container
# uid that no dataset is owned by cannot write its own state. See the residual risk
# in hosts/server/runbook.md.
[Unit]
Description=llama.cpp model server for the agent-local deployment
Requires=zfs-ready@state-agent-model.service smortress-nvidia-cdi.service
After=network-online.target zfs-ready@state-agent-model.service smortress-nvidia-cdi.service
Wants=network-online.target

[Container]
# b12602 of scripts/app-images.sh: the first llama.cpp build with the merged
# Inkling 2 loop architecture (PR #32694). b12464, the previous pin, predates it.
Image=ghcr.io/smores56/homelab-platform/agent-model@sha256:26f89ebd3bf17a5ecf6caee62bdabfa55abea3058150879f6f07b1fc786baa2d
ContainerName=smortress-agent-model
Network=agent-local.network
User=1000:1000
AddDevice=nvidia.com/gpu=all
SecurityLabelType=nvidia_container_t
# The image entrypoint is the server binary, so Exec= is the argument list only.
#
# `-c` is the TOTAL context and llama.cpp divides it across `--parallel` slots,
# so 196608 / 3 gives every slot the 65,536 the gateway config pins. Three slots
# is the subagent bound: parent plus `delegation.max_concurrent_children: 2`, and
# a fourth slot is what the card cannot pay for (measured 23,990 MiB of 24,576 at
# four 64k slots with fp16 KV).
#
# Measured on this host with Inkling 2 Mini AD-Q4_K: 20,834 MiB resident, 57 tok/s
# generation, 123 tok/s prompt, load 33 s. `-ub 128` is what makes it fit: the
# prompt graph is sized by the micro-batch, and at the default 512 it wants a
# 6.5 GiB compute buffer that fails cudaMalloc. `-ctk/-ctv q8_0` halves the KV
# cache (2 GiB per 64k slot) and needs `-fa on`, which is also what keeps the
# attention graph small. Dropping any of the three puts the load back over the
# card's 24 GiB.
# One line, not a backslash continuation: Quadlet's parser is the thing that has
# to agree with it, and an Exec= split across lines is a question, not a fact.
Exec=--host 0.0.0.0 --port 8080 -ngl 99 -c 196608 --parallel 3 -ub 128 -fa on -ctk q8_0 -ctv q8_0 --jinja --alias local-agent -m /models/Inkling-2-Mini-AD-Q4_K.gguf
Volume=/var/lib/agent/model:/models:ro,z
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
# 143 is SIGTERM, which a deliberate stop sends: not a failure.
SuccessExitStatus=143
# Loading a 16.5 GiB model onto the GPU takes about half a minute, and the first
# start after a reboot also relabels the dataset, which is why the timeout is
# generous.
Restart=on-failure
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
