# The personal deployment's only network, and the reason it has no route off the
# host. `Internal=true` makes podman create a bridge with no default route and no
# NAT: the model server and the personal gateway resolve and reach each other by
# container name, and nothing on this network can reach anything else -- not the
# host's other networks, not the LAN, not the internet.
#
# Reachability from the tailnet is unaffected: the gateway publishes on
# 127.0.0.1 (units/quadlet/agent-local.container) and Tailscale Serve forwards to
# that host port. A published port is host-side DNAT toward the container, not a
# route inside its namespace, so it adds nothing to what the container can dial.
[Unit]
Description=Smortress agent-local network (no egress)

[Network]
Internal=true
