# The personal deployment's source facade: the MCP server the personal gateway
# reads its sources and its memory through (apps/agent_facade/, docs/agent-facade.md).
#
# Code delivery is the agent-proxy pattern (units/quadlet/agent-proxy.container):
# the same pinned agent-runtime image, `Entrypoint=python3` instead of the image's
# gateway dispatcher, and the program in the image at the path PYTHONPATH names
# (images/agent-runtime/Containerfile). No host mount: an agent change rebuilds
# that container image, not the OS, and there is no second copy to drift.
#
# It publishes nothing, and that is the boundary: its only client is
# smortress-agent-local, which reaches it by container name on
# agent-local.network. A published port would be a second way in with no
# consumer, and Tailscale Serve would have to be told to skip it -- the same
# reasoning as the hosted proxy, which publishes only for the operator's own
# curl and is not a Serve route either.
#
# The token is a mounted file, never an environment variable and never an
# argument: `--token-file` names it, the process reads it once, and it appears in
# no log line and in no response. The gateway holds the same value in its seeded
# config.yaml, which is why a facade token rotation is a two-step operator action
# (docs/manual-steps.md section 40.11).
#
# /memory is the memory subdirectory of the personal state dataset, not the
# dataset root: the gateway's sessions, skills and .env live one level up and are
# none of this process's business. smortress-agent-config.service creates it with
# the dataset's uid and mode, because a directory podman has to create for a bind
# mount would be root-owned inside a 0750 dataset.
#
# /run/agent-shell is this class's shell transport (SDLC #860): the directory
# holding the socket served by smortress-agent-shell-bridge-personal.service,
# mounted rw because connect(2) needs write permission on the socket inode, and
# only this container gets it. The socket's class is a constant in that unit, so
# `shell.run` here runs a job with `--network=none` and no host mount: disposable
# scratch and the container's read-only root, nothing reachable. The directory,
# not the socket file, is mounted so a bridge restart replaces the socket inside
# an inode this container still sees. The general facade mounts only its own
# class's directory, so neither container can dial the other class's socket -- the
# two facades share uid 1000, so the mount is the separation.
[Unit]
Description=Agent source facade, personal deployment (MCP on agent-local.network)
Requires=zfs-ready@state-agent-local.service sops-decrypt.service smortress-app-secrets.service smortress-agent-config.service smortress-agent-shell-bridge-personal.service
After=network-online.target zfs-ready@state-agent-local.service sops-decrypt.service smortress-app-secrets.service smortress-agent-config.service smortress-agent-shell-bridge-personal.service
Wants=network-online.target

[Container]
Image=ghcr.io/smores56/homelab-platform/agent-runtime@sha256:9cd8202e19dfe1375ae015f35e11b694bd4df21907819b67844d25caf4650e97
ContainerName=smortress-agent-facade-personal
Network=agent-local.network
User=1000:1000
Entrypoint=python3
Exec=-m apps.agent_facade --transport http --deployment personal --token-file /run/secrets/agent-facade-personal-token --memory-root /memory --index-root /index --replica mail=/replica/mail --replica calendar=/replica/calendar --replica finance=/replica/finance --replica brave=/replica/brave --replica notes=/replica/notes --replica tasks=/replica/tasks --replica photos=/replica/photos --replica music=/replica/music --host 0.0.0.0 --port 18004 --shell-socket /run/agent-shell/personal.sock
Secret=agent-facade-personal-token,type=mount,target=/run/secrets/agent-facade-personal-token,uid=1000,gid=1000,mode=0400
Environment=PYTHONPATH=/usr/lib/agent-facade/libs:/usr/lib/agent-facade
# The image layer carrying the code is read-only, so a bytecode cache write can only fail.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=UTC
# No :z here: /usr is a read-only composefs mount, so a relabel fails with EROFS.
# /usr content is already readable by the container type; only dataset mounts relabel.
Volume=/var/lib/agent/local/memory:/memory:z
# The published raw generations the personal facade answers from. Read-only: the
# collector owns this tree, and a new generation is picked up without a restart
# (apps/agent_facade/replica_sources.py). It sits inside the same state dataset as
# memory and the gateway, so a cold restore carries the feed and its index.
Volume=/var/lib/agent/local/replica:/replica:ro,z
# The derived source index (apps/agent_facade/source_index.py): one SQLite file per
# replica source and generation. An existing file is opened, never rebuilt: it
# carries the projection it was built from, so a restarted facade searches it
# without projecting the generation. A new generation has no file yet, so its
# first search pays one projection and writes it; deleting the tree costs one
# such build and nothing else. It is not in the memory tree because it answers
# for the replicas, not for what the agent wrote.
Volume=/var/lib/agent/local/index:/index:z
# The personal bridge's directory, and nothing else is in it. No :ro: connect(2)
# needs the write bit on the socket inode, and the mount is the permission.
Volume=/run/smortress/agent-shell-personal:/run/agent-shell:z
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
# 143 is SIGTERM, which a deliberate stop sends: not a failure.
SuccessExitStatus=143
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
