# The general deployment's source facade: the MCP server the general gateway
# reads its sources and its memory through (apps/agent_facade/,
# docs/agent-facade.md). Same shape as the personal one, on the internet-connected
# network, with its own token and its own source table (`repos`, `books`).
#
# Code delivery is the agent-proxy pattern (units/quadlet/agent-proxy.container):
# the same pinned agent-runtime image, `Entrypoint=python3` instead of the image's
# gateway dispatcher, and the program in the image at the path PYTHONPATH names
# (images/agent-runtime/Containerfile). No host mount: an agent change rebuilds
# that container image, not the OS.
#
# It publishes nothing: its only client is smortress-agent-general, which reaches
# it by container name on agent-general.network. The facade's own egress is not
# the point -- its adapters are in-process fixtures and it has no upstream host to
# reach -- so what contains it is that nothing else on this host can dial it and
# it holds no credential but its own revocable token.
#
# /memory is the memory subdirectory of the general state dataset: the gateway's
# sessions and .env live one level up. smortress-agent-config.service creates it
# with the dataset's uid and mode, because a directory podman has to create for a
# bind mount would be root-owned inside a 0750 dataset.
#
# /run/agent-shell is this class's shell transport (SDLC #859): the directory
# holding the socket served by smortress-agent-shell-bridge.service, mounted rw
# because connect(2) needs write permission on the socket inode, and only this
# container gets it. The directory, not the socket file, is mounted so a bridge
# restart replaces the socket inside an inode this container still sees. With the
# socket the facade serves `shell.run` in the general class; the personal facade
# mounts only its own class's directory (agent-shell-personal), so neither
# container can dial the other class's socket.
[Unit]
Description=Agent source facade, general deployment (MCP on agent-general.network)
Requires=zfs-ready@state-agent-general.service zfs-ready@raw-git.service zfs-ready@raw-books.service sops-decrypt.service smortress-app-secrets.service smortress-agent-config.service smortress-agent-shell-bridge.service
After=network-online.target zfs-ready@state-agent-general.service zfs-ready@raw-git.service zfs-ready@raw-books.service sops-decrypt.service smortress-app-secrets.service smortress-agent-config.service smortress-agent-shell-bridge.service
Wants=network-online.target

[Container]
Image=ghcr.io/smores56/homelab-platform/agent-runtime@sha256:9a454a0888e667fa1744a23eb6fc8d7302e1f18b38a7cb58c4195837d108b975
ContainerName=smortress-agent-facade-general
Network=agent-general.network
User=1000:1000
Entrypoint=python3
Exec=-m apps.agent_facade --transport http --deployment general --token-file /run/secrets/agent-facade-general-token --memory-root /memory --host 0.0.0.0 --port 18005 --shell-socket /run/agent-shell/general.sock --repo-root /srv/git --books-root /srv/books
Secret=agent-facade-general-token,type=mount,target=/run/secrets/agent-facade-general-token,uid=1000,gid=1000,mode=0400
Environment=PYTHONPATH=/usr/lib/agent-facade/libs:/usr/lib/agent-facade
# The image layer carrying the code is read-only, so a bytecode cache write can only fail.
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=UTC
# No :z here: /usr is a read-only composefs mount, so a relabel fails with EROFS.
# /usr content is already readable by the container type; only dataset mounts relabel.
Volume=/var/lib/agent/general/memory:/memory:z
# The bridge's directory, and nothing else is in it. No :ro: connect(2) needs
# the write bit on the socket inode, and the mount is the permission -- the mode
# 0660 group is this container's gid, so no other container on the host can open
# it even if it were mounted elsewhere. The directory's inode is stable across a
# bridge restart, so the socket the bridge rebinds appears here without a
# container restart.
Volume=/run/smortress/agent-shell-general:/run/agent-shell:z
# The two general sources (SDLC #851): live, read-only, and labeled already.
# No :z/:Z and no label=disable: both trees carry container_file_t and keep it,
# so a bind never rewrites a shared label. /var/srv/git is 0770 with an ACL for
# this container's uid 1000 (provisioning grants read); /var/srv/books is
# core:core 0740. Nothing here is a personal path.
Volume=/var/srv/git:/srv/git:ro
Volume=/var/srv/books:/srv/books:ro
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL

[Service]
# 143 is SIGTERM, which a deliberate stop sends: not a failure.
SuccessExitStatus=143
Restart=on-failure
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
