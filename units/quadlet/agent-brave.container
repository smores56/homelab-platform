# The browsing collector's provider half: one headless Brave, one profile, one
# route off this host.
#
# Brave has no CLI to join a Sync chain. The profile this container runs is
# therefore seeded rather than joined: `smortress-agent-brave-seed.service` plants
# the OSCrypt blob the desktop's own join wrote into `Default/Preferences` before
# this unit starts, and `--password-store=basic` is what makes that blob
# decryptable (the fixed "peanuts" key). The seed is resident on the volume for as
# long as this container runs, which is why the volume is a quarantine path and a
# copy of it is a copy of the chain's key (docs/manual-steps.md section 40.17).
#
# The ONLY egress is the allowlist proxy. `agent-brave.network` is `Internal=true`:
# no default route, no NAT, and exactly two peers -- `agent-egress-proxy` at
# 10.89.73.2:3128 and `agent-egress-dns` at 10.89.73.3:53. `--proxy-server` names
# the proxy by address, and the proxy tunnels only `sync-v2.brave.com:443` for the
# `brave` label in `/etc/smortress/agent/egress-policy.json`; `--dns` names the
# responder that refuses every other name. A browser that ignored both flags would
# dial an address the network cannot route, so the reach is a property of the
# network plus a reviewed policy document, not of this command line.
#
# The profile volume is the chain membership: it holds the seed, the sync engine's
# device id and whatever the chain has delivered. Deleting it does not just lose
# the collected history, it removes this host from the chain until the seed is
# planted again -- and a re-seed of the *same* seed is a new device id, which the
# next generation reflects. It is `:z` because the container writes it.
#
# `--no-sandbox` is required, not a shortcut: the kernel sandbox needs user
# namespaces and a setuid helper this container is not given (no capabilities, no
# new privileges), and Chromium refuses to start as the sandbox it cannot build.
# The compensation is that the browser is the least privileged thing here: read-only
# root, tmpfs `/tmp`, no capabilities, one volume, and one hostname it can reach.
#
# Memory is bounded because Chromium grows into whatever it is given and this is a
# 16 GiB host shared with the model server. 143 is a clean exit: `podman stop` and
# a host shutdown both send SIGTERM, and `Restart=always` must not read that as a
# crash and start a fresh browser during the shutdown window.
[Unit]
Description=Headless Brave for the browsing collector (Sync chain member)
Requires=zfs-ready@state-agent-local.service smortress-agent-config.service agent-brave-network.service
After=zfs-ready@state-agent-local.service smortress-agent-config.service agent-brave-network.service smortress-agent-brave-seed.service

[Container]
# The digest of the `publish-brave` run for images/brave/Containerfile; a rebuild
# prints a new row in scripts/app-images.sh and this line moves with it.
Image=ghcr.io/smores56/homelab-platform/brave@sha256:9b505ba383925597812ffb1d52876b3b5f8f00b2bf999418936521cbb13d707e
ContainerName=smortress-agent-brave
Network=agent-brave.network
User=1000:1000
Volume=/var/lib/agent/local/quarantine/brave-profile:/data:z
# Nothing outside `/data` and `/tmp` is written: Chromium's caches, the profile and
# the sync engine's state are all under `--user-data-dir`.
ReadOnly=true
Tmpfs=/tmp:rw,size=256m
# The two addresses are the egress gate's static peers, spelled as addresses
# because a name would have to be resolved by the responder that refuses names.
PodmanArgs=--dns=10.89.73.3 --memory=640m --memory-swap=800m
Exec=--headless=new --no-sandbox --disable-gpu --disable-dev-shm-usage --password-store=basic --user-data-dir=/data --proxy-server=http://10.89.73.2:3128 --no-first-run --no-default-browser-check about:blank
NoNewPrivileges=true
DropCapability=ALL

[Service]
Restart=always
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
