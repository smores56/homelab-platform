#cloud-config
# Ubuntu 26.04.1 autoinstall for smortress (T6, smores56/sdlc#691).
#
# /boot is a plain ext4 partition: GRUB cannot read a kernel and initrd from a
# LUKS volume without GRUB_ENABLE_CRYPTODISK, which would put a passphrase
# prompt before the Clevis unlock.
#
# Placeholders are substituted by build-seed.sh; this file is committed with
# none of the real values. Read provision/smortress/README.md before building a
# seed: the root passphrase ends up inside the seed image.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: America/New_York
  identity:
    hostname: smortress
    username: ansible
    realname: Smortress Bootstrap
    # Locked password: the bootstrap user authenticates by SSH key only.
    password: "*"
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - __SSH_AUTHORIZED_KEY__
  packages:
    - clevis
    - clevis-dracut
    - clevis-tpm2
    - clevis-luks
    - cryptsetup
    - linux-modules-zfs-generic
    - openssh-server
    - python3
    - sudo
    - zfsutils-linux
    - zfs-zed
  early-commands:
    - |
      set -eu
      install -d -m 0700 /run/smortress-keys
      head -c 64 /dev/urandom | base64 > /run/smortress-keys/data.key
      chmod 0600 /run/smortress-keys/data.key
  storage:
    config:
      - id: disk-target
        type: disk
        ptable: gpt
        wipe: superblock-recursive
        preserve: false
        grub_device: true
        match:
          serial: __DISK_SERIAL__
      - id: part-esp
        type: partition
        device: disk-target
        size: 1G
        flag: boot
        grub_device: true
      - id: fmt-esp
        type: format
        fstype: fat32
        volume: part-esp
      - id: part-boot
        type: partition
        device: disk-target
        size: 2G
      - id: fmt-boot
        type: format
        fstype: ext4
        label: boot
        volume: part-boot
      - id: mnt-boot
        type: mount
        path: /boot
        device: fmt-boot
      - id: mnt-esp
        type: mount
        path: /boot/efi
        device: fmt-esp
      - id: part-root
        type: partition
        device: disk-target
        size: 148G
      - id: dm-root
        type: dm_crypt
        volume: part-root
        dm_name: luks-root
        key: "__LUKS_ROOT_PASSPHRASE__"
      - id: fmt-root
        type: format
        fstype: ext4
        label: root
        volume: dm-root
      - id: mnt-root
        type: mount
        path: /
        device: fmt-root
      - id: part-data
        type: partition
        device: disk-target
        size: 300G
      - id: dm-data
        type: dm_crypt
        volume: part-data
        dm_name: luks-data
        keyfile: /run/smortress-keys/data.key
  late-commands:
    - curtin in-target -- install -d -m 0700 /etc/luks
    - |
      set -eu
      install -m 0400 -o root -g root /run/smortress-keys/data.key /target/etc/luks/data.key
      # curtin writes "none" even when the volume was created with a keyfile;
      # name the keyfile so systemd-cryptsetup unlocks without a prompt.
      awk 'BEGIN { OFS = " " } $1 == "luks-data" { $3 = "/etc/luks/data.key"; $4 = "luks,discard,nofail" } { print }' \
        /target/etc/crypttab > /target/etc/crypttab.new
      cat /target/etc/crypttab.new > /target/etc/crypttab
      rm -f /target/etc/crypttab.new /run/smortress-keys/data.key
    - |
      set -eu
      # The bootstrap user has no password; Ansible replaces this with the
      # managed admin users and their keys on the first converge.
      printf 'ansible ALL=(ALL) NOPASSWD:ALL\n' > /target/etc/sudoers.d/90-bootstrap
      chmod 0440 /target/etc/sudoers.d/90-bootstrap
    - |
      set -eu
      cat > /target/usr/local/sbin/smortress-provision <<'SCRIPT'
      #!/bin/sh
      # Create the data pool once, then leave it to zpool-import-tank.service.
      set -eu
      if zpool list -H -o name tank >/dev/null 2>&1; then exit 0; fi
      if zpool import -d /dev/mapper tank >/dev/null 2>&1; then
        zpool set cachefile=none tank
        exit 0
      fi
      zpool create -o cachefile=none -o ashift=12 -O mountpoint=none -O canmount=off \
        -O compression=zstd -O atime=off -O xattr=sa -O acltype=posixacl \
        tank /dev/mapper/luks-data
      zpool set cachefile=none tank
      SCRIPT
      chmod 0755 /target/usr/local/sbin/smortress-provision
      cat > /target/etc/systemd/system/smortress-provision.service <<'UNIT'
      [Unit]
      Description=Create the ZFS data pool on first boot
      Requires=systemd-cryptsetup@luks\x2ddata.service
      After=systemd-cryptsetup@luks\x2ddata.service
      ConditionPathExists=/dev/mapper/luks-data

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/smortress-provision

      [Install]
      WantedBy=multi-user.target
      UNIT
    - |
      set -eu
      printf 'add_dracutmodules+=" network clevis "\n' > /target/etc/dracut.conf.d/90-clevis.conf
      sed -i 's|^GRUB_CMDLINE_LINUX_DEFAULT="\(.*\)"|GRUB_CMDLINE_LINUX_DEFAULT="\1 ip=dhcp"|' /target/etc/default/grub
      grep -q 'ip=dhcp' /target/etc/default/grub
    - |
      set -eu
      cat > /target/usr/local/sbin/smortress-clevis-bind <<'CLEVIS'
      #!/bin/sh
      # Bind Clevis to the root volume: sss (Tang + TPM2, both required) plus a
      # bare TPM2 token so a host can still boot when Tang is unreachable.
      # Usage: smortress-clevis-bind <tang-url> <passphrase-file>
      set -eu
      url=${1:?usage: smortress-clevis-bind <tang-url> <passphrase-file>}
      key=${2:?usage: smortress-clevis-bind <tang-url> <passphrase-file>}
      root_dev=$(cryptsetup status "$(findmnt -no SOURCE /)" | awk '/device:/{print $2}')
      adv=$(curl -fsS "$url/adv")
      if [ -e /dev/tpmrm0 ] || [ -e /dev/tpm0 ]; then
        cfg=$(printf '{"t":2,"pins":{"tang":[{"url":"%s","adv":%s}],"tpm2":{"pcr_ids":"7"}}}' "$url" "$adv")
        clevis luks bind -d "$root_dev" sss "$cfg" -y -k "$key"
        clevis luks bind -d "$root_dev" tpm2 '{"pcr_ids":"7"}' -y -k "$key"
      else
        cfg=$(printf '{"url":"%s","adv":%s}' "$url" "$adv")
        clevis luks bind -d "$root_dev" tang "$cfg" -y -k "$key"
      fi
      dracut -f
      CLEVIS
      chmod 0755 /target/usr/local/sbin/smortress-clevis-bind
    - |
      set -eu
      rm -f /target/var/log/installer/*autoinstall* /target/var/log/installer/curtin-install-cfg.yaml
    - curtin in-target -- update-grub
    - curtin in-target -- sh -c 'dracut -f' || true
    - curtin in-target -- systemctl enable smortress-provision.service
