[Unit]
Description=Import the smortress ZFS pool on later boots
Requires=systemd-cryptsetup@luks\x2ddata.service
After=systemd-cryptsetup@luks\x2ddata.service smortress-provision.service
ConditionPathExists=/dev/mapper/luks-data

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/zpool-import-tank

[Install]
WantedBy=multi-user.target
