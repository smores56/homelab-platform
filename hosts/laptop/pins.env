# Every external reference the derived image consumes. The NymVPN pin below is a
# real pin: a version and two tarball hashes, moved by
# scripts/refresh-pins.sh --write. The base is not pinned; FEDORA_VERSION is
# the knob that selects which release's tag the image tracks.
#
# The base is Fedora's minimal bootc image for the release the laptop runs. It
# is the same Fedora kernel the official atomic desktops ship, which is what
# keeps shim -> GRUB -> kernel verification working without a MOK enrollment.
#
# It tracks the moving release tag, not a digest: quay garbage-collects the
# manifests behind fedora-bootc:${FEDORA_VERSION} within hours, so a pinned
# digest rots into `manifest unknown` build failures. Each build resolves the tag
# and records the digest as org.opencontainers.image.base.digest, which is what a
# built image declares its base by; bootc rollback is the way back from one that
# misbehaves.
FEDORA_VERSION=45
BASE_IMAGE=quay.io/fedora/fedora-bootc:${FEDORA_VERSION}

# The repository CI pushes to. The tag is derived from the commit; the digest
# is what bootc consumes after the signature check.
IMAGE_REPO=ghcr.io/smores56/smorespro-image

# CI-only binaries, downloaded by the publish workflow and hash-checked there.
COSIGN_VERSION=2.6.1
COSIGN_SHA256=064954c5d8c7e3b28188eee5b1727b31c411550bc5fefd41aa672d3c761d103a

# NymVPN ships no Fedora RPM, so the release tarball is vendored instead: the
# daemon and the CLI, hashed per architecture. refresh-pins.sh --write derives
# both hashes from the release's checksums.txt; the version is whichever stable
# tag actually carries a core tarball (some tags are F-Droid-only).
NYM_VERSION=2026.15.0
NYM_SHA256_AMD64=4a46d2d9fb3dcad0bcaf73ef1ebc3bfcf0f28ead4cd53004b0ced0b8c4e00fcd
NYM_SHA256_ARM64=d826f42a588c31ee6c77ba8ad778e785ae305289f904a84a85834dce0e235ab3
