#!/usr/bin/env bats
# bats file_tags=agent-data-plane
# The agent data plane's first slice (SDLC #979, T1): one personal Mirage
# workspace, the host directories it may reach, the one live feed, and the two
# policy rules that make a delete a human decision.
#
# The suite is static for everything that only exists on smortress (the unit is
# generated by a Quadlet, the token is ciphertext, the daemon is a pinned image)
# and behavioral for the one part that runs anywhere: the feed watcher is started
# against a scratch tree and its records are read back.
load ../helpers

# A watcher started by a test must not outlive it: bats waits on a background
# job's stdout, so the process is detached from the harness's fds and killed
# here as well as in the test's own trap.
teardown() {
  if [[ -n ${watcher_pid:-} ]]; then
    kill "$watcher_pid" 2>/dev/null || true
    wait "$watcher_pid" 2>/dev/null || true
    watcher_pid=
  fi
}

workspace_config=bootc/server/rootfs/etc/smortress/mirage/personal.yaml
quadlet=units/quadlet/mirage-personal.container
watcher=scripts/agent-todos-watch.py
hermes=bootc/server/rootfs/etc/smortress/agent/local-config.yaml

# A YAML block's lines, flattened: the suite asserts on keys that must be there,
# not on the shape of the file.
block_of() { # block_of FILE IDENT
  awk -v ident="$2" '
    $0 ~ "^[[:space:]]*"ident":" {found = 1; print; next}
    found && /^[[:space:]]*[^[:space:]#]/ {print}
  ' "$1"
}

@test "the workspace mounts the todos root read-write" {
  run block_of "$workspace_config" /data/todos
  assert_success
  assert_contains "$output" "root: /srv/files/todos"
  assert_contains "$output" "mode: write"
}

@test "the vault is read-only in the workspace" {
  run block_of "$workspace_config" /data/vault
  assert_success
  assert_contains "$output" "mode: read"
}

@test "the feed is read-only in the workspace" {
  run block_of "$workspace_config" /feed
  assert_success
  assert_contains "$output" "root: /state/feed"
}

@test "the workspace has no network, so the ask admin endpoint is unreachable" {
  grep -qxF '    network: false' "$workspace_config"
}

@test "the Mirage CLI is denied, not left to a blocked socket" {
  run block_of "$workspace_config" mirage
  assert_success
  assert_contains "$output" "decision: deny"
}

@test "a delete is an ask, not a deny" {
  run block_of "$workspace_config" rm
  assert_success
  assert_contains "$output" "decision: ask"
}

@test "the instance joins the egress-free personal network and publishes nothing" {
  grep -qxF 'Network=agent-local.network' "$quadlet"
  ! grep -q '^PublishPort=' "$quadlet"
}

@test "the instance runs as uid 1000 with a read-only root and no capabilities" {
  grep -qxF 'User=1000:1000' "$quadlet"
  grep -qxF 'ReadOnly=true' "$quadlet"
  grep -qxF 'DropCapability=ALL' "$quadlet"
  grep -qxF 'NoNewPrivileges=true' "$quadlet"
}

@test "the instance waits for both datasets it mounts" {
  grep -q '^Requires=.*zfs-ready@state-agent-local.service' "$quadlet"
  grep -q '^Requires=.*zfs-ready@raw-files.service' "$quadlet"
}

@test "the workspace config is mounted from the image, not copied into the dataset" {
  grep -qxF 'Volume=/etc/smortress/mirage/personal.yaml:/etc/mirage/workspace.yaml:ro' "$quadlet"
}

@test "the image is pinned by a digest the pin table also names" {
  run grep -E '^Image=ghcr\.io/smores56/homelab-platform/mirage@sha256:[0-9a-f]{64}$' "$quadlet"
  assert_success
  digest=${output#*@}
  run grep -F "'mirage|built:images/mirage/Containerfile|$digest'" scripts/app-images.sh
  assert_success
}

@test "the token reaches the daemon through mirage.env, not a Podman env secret" {
  refute grep -q '^Secret=' "$quadlet"
  grep -qxF 'EnvironmentFile=/var/lib/agent/local/mirage.env' "$quadlet"
  run grep -n 'MIRAGE_AUTH_TOKEN=%s' scripts/agent-config-seed.sh
  assert_success
}

@test "the gateway points at the workspace MCP through the proxy port, with a bearer token" {
  run grep -A3 '^  mirage:' "$hermes"
  assert_success
  assert_contains "$output" "http://smortress-mirage-personal:18010/v1/workspaces/personal/mcp"
  assert_contains "$output" "Authorization: __MIRAGE_TOKEN__"
  run grep -n 'Bearer \$mirage_token_value' scripts/agent-config-seed.sh
  assert_success
}

@test "the token is ciphertext with a manifest row and no plaintext in the tree" {
  run grep -qxF 'mirage-personal-token.yaml mirage.json mirage.personal_token root root 0400 value' \
    bootc/server/rootfs/usr/share/smortress/secrets.manifest
  assert_success
  run python3 -c 'import json,sys; print(json.load(open("secrets/mirage.json"))["mirage"]["personal_token"])'
  assert_success
  assert_contains "$output" 'ENC['
  ! git grep -qF "$(python3 -c 'import json;print(json.load(open("secrets/mirage.json"))["mirage"]["personal_token"])')" -- . ':!secrets/mirage.json'
}

@test "the image carries the watcher and the workspace config, and enables the unit" {
  run grep -F 'COPY scripts/agent-todos-watch.py /usr/libexec/agent-todos-watch' bootc/server/Containerfile
  assert_success
  run grep -F 'units/quadlet/mirage-personal.container' bootc/server/Containerfile
  assert_success
  run grep -F 'smortress-agent-todos-watch.service' bootc/server/Containerfile
  assert_success
}

@test "the watcher records a create, an update and a delete as JSON lines" {
  root=$BATS_TEST_TMPDIR/todos
  feed=$BATS_TEST_TMPDIR/feed
  mkdir -p "$root"
  SMORTRESS_AGENT_TODOS_ROOT=$root SMORTRESS_AGENT_FEED_DIR=$feed \
    python3 "$watcher" >/dev/null 2>&1 &
  watcher_pid=$!
  # The watcher creates the feed file once its watch is installed, so the first
  # write cannot land before there is anything watching. Without this the create
  # is lost to a start-up race and the test proves nothing about ordering.
  for _ in $(seq 1 50); do
    [[ -e $feed/changes.jsonl ]] && break
    sleep 0.1
  done
  [[ -e $feed/changes.jsonl ]]
  printf -- '- milk\n' >"$root/a.md"
  printf -- '- eggs\n' >>"$root/a.md"
  rm -f "$root/a.md"
  for _ in $(seq 1 50); do
    [[ $(grep -c . "$feed/changes.jsonl" 2>/dev/null || echo 0) -ge 3 ]] && break
    sleep 0.1
  done

  run cat "$feed/changes.jsonl"
  assert_success
  assert_contains "$output" '"kind": "create"'
  assert_contains "$output" '"kind": "update"'
  assert_contains "$output" '"kind": "delete"'
  assert_contains "$output" "\"path\": \"$root/a.md\""
  assert_contains "$output" '"source": "todos"'
  # The sequence is the reader's only restart signal, so it must be ordered.
  run python3 - "$feed/changes.jsonl" <<'PY'
import json, sys
seqs = [json.loads(line)["seq"] for line in open(sys.argv[1])]
assert seqs == sorted(seqs), seqs
print("ordered")
PY
  assert_success
}

@test "the feed is a ring buffer, not a ledger" {
  root=$BATS_TEST_TMPDIR/ring/todos
  feed=$BATS_TEST_TMPDIR/ring/feed
  mkdir -p "$root"
  SMORTRESS_AGENT_TODOS_ROOT=$root SMORTRESS_AGENT_FEED_DIR=$feed \
    SMORTRESS_AGENT_FEED_KEEP=4 SMORTRESS_AGENT_FEED_TRIM_AT=5 \
    python3 "$watcher" >/dev/null 2>&1 &
  watcher_pid=$!
  for _ in $(seq 1 12); do
    printf 'x\n' >>"$root/a.md"
    sleep 0.05
  done
  # A trim happens on a write every 64 records or when the file is over the
  # high-water mark; the second condition is what this test drives, so ask the
  # watcher for enough events to cross both.
  for _ in $(seq 1 100); do
    [[ $(grep -c . "$feed/changes.jsonl" 2>/dev/null || echo 0) -le 5 ]] && break
    sleep 0.1
  done
  run bash -c 'grep -c . "$1"' _ "$feed/changes.jsonl"
  assert_success
  [[ $output -le 5 ]]
}
