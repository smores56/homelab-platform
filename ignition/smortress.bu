# Smortress install config for the uCore auto-rebase path.
#
# Derived from ucore/examples/ucore-autorebase.butane at
# 75ec7d8d10bc8af6fe23a284ea108bacd50f3173, with both image references pointing
# at our derived image. Stage 1 rebases through the unverified registry
# reference; stage 2 uses the signed reference once the derived image's policy
# (and its public key) is running.
#
# Networking is the FCOS default DHCP profile on the wired NIC. The install
# command appends `ip=dhcp rd.neednet=1` so dracut can reach Tang before root
# is opened; no mutable network manager unit or sync unit is configured here.
#
# Rendered by scripts/render-ignition.sh. No secret enters this file (design
# #701): the only key slots are the Clevis binding and a key the host generates
# for itself. The render is still mode 0600 because it carries the account
# password hash; FCOS removes /boot/ignition after provisioning.
variant: fcos
version: 1.7.0

passwd:
  users:
    - name: smores
      # Dead on this image, on purpose. sshd's AuthorizedKeysFile is
      # /etc/ssh/authorized_keys.d/smores, shipped in the image with the one
      # ed25519 key (design #767), so nothing reads ~/.ssh/authorized_keys and
      # this key authenticates nobody while that deployment is running. It is
      # kept for one case: `bootc rollback` to a deployment whose drop-in still
      # names the Ignition file restores that path, and this then becomes the key
      # a console-free rollback can log in with. It is not, and must not become,
      # a second AuthorizedKeysFile path.
      ssh_authorized_keys_local:
        - ignition/operator/ssh_authorized_keys
      password_hash: '@SMORES_PASSWORD_HASH@'

storage:
  directories:
    - path: /etc/ucore-autorebase
      mode: 0754
  # The authorised-key directory that used to sit under /var/lib/homelab is gone
  # with the Ignition-delivered key set (design #767): the key ships in the image
  # at /etc/ssh/authorized_keys.d/smores. /var/lib/homelab itself stays, at 0711
  # from bootc/server/rootfs/etc/tmpfiles.d/smortress.conf, because the age identity and
  # the applications' state live under it.
  # FCOS owns p1 BIOS-BOOT, p2 EFI-SYSTEM, p3 boot and p4 root. The approved
  # "two encrypted storage roots" intent is kept: p4 is the LUKS root and a new
  # p5 carries the LUKS data device. Renumbering the FCOS boot partitions is not
  # supported by the raw-image installer.
  #
  # p4 is 300 GiB, not the 100 GiB it was installed with. Root also carries the
  # container images, the journal and every restore that fails to name a data
  # disk, and 100 GiB was filled by drill scratch three times. Growing it means
  # recreating p5, because a ZFS vdev cannot shrink. p5 keeps the remainder of
  # the disk.
  disks:
    - device: '@DISK_BY_ID@'
      partitions:
        - label: root
          number: 4
          size_mib: 307200
          resize: true
        - label: luks-data
          number: 5
          size_mib: 0
  # Root unlock is the Clevis SSS binding and nothing else. With no key file,
  # Ignition formats the volume with a key it generates, binds Clevis, then
  # removes the generated key slot (ignition internal/exec/stages/disks/luks.go),
  # so the only slot left is SSS Tang+TPM2 threshold 2. The offline recovery
  # passphrase does not exist yet: the operator adds it with `cryptsetup
  # luksAddKey` after the install (docs/manual-steps.md section 37 step 8.1),
  # which is why a host that skips that step has no offline recovery.
  # The data partition (p5) is created here and stays unformatted: Ignition must
  # not carry a key for it. smortress-data-init.service generates the key file
  # on the host and runs luksFormat on the first boot.
  luks:
    - name: root
      label: luks-root
      device: /dev/disk/by-partlabel/root
      clevis:
        tang:
          - url: '@TANG_URL@'
            thumbprint: '@TANG_THUMBPRINT@'
        tpm2: true
        threshold: 2
      discard: true
      wipe_volume: true
  filesystems:
    - device: /dev/mapper/root
      format: xfs
      label: root
      wipe_filesystem: true
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: smortress
    - path: /etc/pki/containers/smortress.pub
      mode: 0644
      overwrite: true
      contents:
        local: lib/containers/cosign.pub
    - path: /etc/containers/policy.json
      mode: 0644
      overwrite: true
      contents:
        local: lib/containers/policy.json
    - path: /etc/containers/registries.d/ghcr.io-smortress.yaml
      mode: 0644
      overwrite: true
      contents:
        local: lib/containers/registries.d/ghcr.io-smortress.yaml

systemd:
  units:
    # BEGIN AUTOREBASE — removed by `render-ignition.sh --stock`, which installs
    # onto the base and leaves the switch to `bootc switch` later.
    - name: ucore-unsigned-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to the derived unsigned OCI reference and reboot
        ConditionPathExists=!/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-unverified-registry:@DERIVED_IMAGE@
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/unverified
        ExecStart=/usr/bin/systemctl disable ucore-unsigned-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
    - name: ucore-signed-autorebase.service
      enabled: true
      contents: |
        [Unit]
        Description=uCore autorebase to the derived signed OCI reference and reboot
        ConditionPathExists=/etc/ucore-autorebase/unverified
        ConditionPathExists=!/etc/ucore-autorebase/signed
        After=network-online.target
        Wants=network-online.target
        [Service]
        Type=oneshot
        StandardOutput=journal+console
        ExecStart=/usr/bin/rpm-ostree rebase --bypass-driver ostree-image-signed:docker://@DERIVED_IMAGE@
        ExecStart=/usr/bin/touch /etc/ucore-autorebase/signed
        ExecStart=/usr/bin/systemctl disable ucore-signed-autorebase.service
        ExecStart=/usr/bin/systemctl reboot
        [Install]
        WantedBy=multi-user.target
    # END AUTOREBASE
