#!/bin/sh
# The local gate before any push: the suites the changed paths select.
# `git config core.hooksPath .githooks` enables it.
set -eu
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
# git exports these to a hook; several suites make fixture repositories.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE \
    GIT_PREFIX GIT_QUARANTINE_PATH
cd "$root" || exit 1
# tests/tags.sh prints the suites a changed path selects, or nothing.
selected=$(tests/tags.sh --changed) || exit 2
[ -n "$selected" ] || exit 0
# shellcheck disable=SC2086  # one path per line, deliberately unquoted
# A hung test must fail the push instead of blocking it; the slowest test in the
# tree is ~12s, the two former monoliths included. The whole matrix is one pool,
# so the job count is what a big file gets too: app-quadlets' 572 registered
# tests take 183s at four jobs and 40s at sixteen.
exec env BATS_TEST_TIMEOUT="${BATS_TEST_TIMEOUT:-120}" \
    bats --jobs "${BATS_JOBS:-$(nproc)}" $selected
