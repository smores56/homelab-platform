# smortress agent-runtime: the pinned Hermes runtime plus the programs this
# repository ships into it.
#
# The two gateways run the upstream image untouched. Every other consumer runs
# our code inside that same image: the hosted-model proxy (`apps/agent_proxy/`),
# the collectors and the mail stream, which need `apps/brave_ingest/` plus the
# `libs/data_plane/` they import. Those used to be installed by the bootc image
# under `/usr/lib/data-plane` (and `/usr/libexec/agent-proxy`) and bind-mounted
# into the container, which made every change to them an OS image rebuild and a
# host reboot. They are baked here instead, at the paths the units already name,
# so `Entrypoint=python3` and
# `PYTHONPATH=/usr/lib/data-plane/libs:/usr/lib/data-plane` resolve with no
# host mount at all.
#
# The base is the digest the gateway deployment runs; bumping the runtime moves
# this digest with it. The modules are listed one by one rather than by glob:
# `apps/agent_proxy/tests/` must never reach an
# image, and a module left off the list is an import error at the first start
# instead of a silent difference at review time.
FROM docker.io/nousresearch/hermes-agent@sha256:276d44685c65c0cb2a25f190b63c65c8906f9dc76486fb1c05ae71b5826bda08

COPY libs/data_plane/ /usr/lib/data-plane/libs/data_plane/
COPY apps/brave_ingest/__init__.py apps/brave_ingest/seed.py \
     apps/brave_ingest/snapshot.py /usr/lib/data-plane/apps/brave_ingest/
COPY apps/agent_proxy/proxy.py /usr/libexec/agent-proxy

# The proxy's own unit execs the file directly, so it carries the executable bit
# the bootc image gave it.
RUN chmod 0755 /usr/libexec/agent-proxy

# The shell the agent now runs (SDLC #995) needs two tools the base lacks. `rg`,
# `git` and `curl` are already there; `jq` and `gh` are not.
#
# `sqlite3` is deliberately NOT installed. The apt CLI links the system
# libsqlite3 while the image already carries a different one, and the first query
# answers "SQLite header and source version mismatch" -- measured in this image,
# not assumed. Python ships the same CLI against the library it actually uses:
# `python3 -m sqlite3 <db> 'select ...'` prints 3.53.1 here, which is the version
# worth having. Nothing in the plane needs the apt binary.
#
# The lists are removed in the same layer so a rebuilt image does not carry an
# apt index that goes stale between pins.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends jq gh; \
    rm -rf /var/lib/apt/lists/*

# `git` refuses a repository whose owner is not the effective uid, and the general
# deployment edits /srv/git, which the operator owns (SDLC #1009). The check
# compares uids, so a shared group would not clear it either. Naming every path
# safe is the only lever that does not move repository ownership, and the tree it
# exposes is the operator's own bare repos on a read-write mount -- the grant is
# the mount, and this only stops git second-guessing it.
RUN git config --system --add safe.directory '*'

# The agent's todo interface (SDLC #1000): todo.txt-cli 2.14.0 from the pinned
# release tarball. Debian's todotxt-cli is 2.11.0-2, which still sources
# ./VERSION-FILE from the CWD -- a path the agent can write -- and installs a
# renamed binary under a second global config (GHSA-pm3w-5f88-pwpq). 2.14.0
# reads no external VERSION-FILE, and the checksum is the release's own.
ARG TODOTXT_VERSION=2.14.0
ARG TODOTXT_SHA256=71a703ecbf79a163f1aa9b831e7ea0e6036cdbb06fdfc6b5c3502b627efb873d
RUN set -eux; \
    curl -fsSLo /tmp/todo.tgz \
      "https://github.com/todotxt/todo.txt-cli/releases/download/v${TODOTXT_VERSION}/todo.txt_cli-${TODOTXT_VERSION}.tar.gz"; \
    echo "${TODOTXT_SHA256}  /tmp/todo.tgz" | sha256sum -c -; \
    tar -xzf /tmp/todo.tgz -C /tmp; \
    install -m 0755 "/tmp/todo.txt_cli-${TODOTXT_VERSION}/todo.sh" /usr/local/bin/todo.sh; \
    install -D -m 0644 "/tmp/todo.txt_cli-${TODOTXT_VERSION}/todo_completion" \
      /usr/local/share/bash-completion/completions/todo.sh; \
    rm -rf /tmp/todo.tgz "/tmp/todo.txt_cli-${TODOTXT_VERSION}"

# The config is not optional: todo.sh exits 1 without one. The wrapper names it
# with -d, so an agent-writable $HOME cannot shadow it.
COPY images/agent-runtime/todo.cfg /etc/todo/config
COPY images/agent-runtime/todo /usr/local/bin/todo
RUN chmod 0755 /usr/local/bin/todo
