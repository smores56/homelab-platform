      rpm-ostreed-automatic.timer \
      zincati.service

# Only tailscale0 carries SSH and application traffic; everything else lands
# in the drop zone. The zone file binds tailscale0 and lists the permitted
# services; ports are added there, never published on 0.0.0.0/::.
RUN firewall-offline-cmd --set-default-zone=drop

# Fail the build if the base is not a stream tag, the policy no longer rejects by
# default, or the escalation tooling the runbooks depend on is absent. The base
# must stay a tag: a digest-pinned base rots when upstream garbage-collects it,
# and `:latest` is not a stream the uCore project maintains. The PAM modules are
# the `required` rows of the sudo stack: a base that dropped one would fail closed
# and leave every non-root account unable to escalate at all. A NOPASSWD grant
# would bypass pam_authenticate entirely and void the whole stack.
RUN set -eux; \
    case "${BASE_IMAGE}" in \
      *:latest) echo "BASE_IMAGE must be a stream tag, not :latest: ${BASE_IMAGE}" >&2; exit 1 ;; \
      *@sha256:*) echo "BASE_IMAGE must be a stream tag, not a digest: ${BASE_IMAGE}" >&2; exit 1 ;; \
      *:*) ;; \
      *) echo "BASE_IMAGE must be a tagged reference: ${BASE_IMAGE}" >&2; exit 1 ;; \
    esac; \
    test -n "${BASE_DIGEST}" || { echo "BASE_DIGEST is empty: the image would not record the base it was built on" >&2; exit 1; }; \
    command -v python3 >/dev/null || { echo "the image has no python3 for the plan verifier" >&2; exit 1; }; \
    jq -e '.default[0].type == "reject"' /etc/containers/policy.json >/dev/null; \
    jq -e '.transports.docker["ghcr.io/smores56/homelab-platform"][0].keyPath == "/etc/pki/containers/smortress.pub"' /etc/containers/policy.json >/dev/null; \
    test -s /etc/ssh/authorized_keys.d/smores || { echo "the shipped ssh key file is missing or empty: it is the only key sshd reads (design #767)" >&2; exit 1; }; \
    ! grep -q 'sk-ssh-ed25519' /etc/ssh/authorized_keys.d/smores || { echo "the shipped key file carries a FIDO handle; the image ships a plain ed25519 key (design #767)" >&2; exit 1; }; \
    test -f /usr/lib64/security/libpam_rssh.so || { echo "libpam_rssh.so is missing: it is sudo's touch factor (design #767)" >&2; exit 1; }; \
    test -f /usr/lib64/security/pam_faillock.so || { echo "pam_faillock.so is missing: it counts the sudo gate's failures (design #767)" >&2; exit 1; }; \
    test -f /usr/lib64/security/pam_unix.so || { echo "pam_unix.so is missing: it is the sudo gate's password fallback (design #767)" >&2; exit 1; }; \
    test -e /etc/ssh/sudo_authorized_keys || { echo "the sudo key file is missing: libpam_rssh.so reads it on every prompt (design #767)" >&2; exit 1; }; \
    ! test -f /usr/lib64/security/pam_oath.so || { echo "pam_oath.so is still in the image: sudo's TOTP is retired (design #767)" >&2; exit 1; }; \
    ! grep -rhvE '^[[:space:]]*#' /etc/sudoers /etc/sudoers.d | grep -q 'NOPASSWD' || { echo "a sudoers line grants NOPASSWD: it would bypass pam_authenticate and void the whole stack (design #767)" >&2; exit 1; }
