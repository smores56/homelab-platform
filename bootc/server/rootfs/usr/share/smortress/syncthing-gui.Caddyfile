# The loopback proxy in front of the Syncthing GUI (design #897, T1/T2).
#
# The GUI answers 403 to a Host header it does not expect, and Tailscale Serve
# forwards the client's Host unchanged, so `svc:sync` cannot reach the GUI unless
# the header is the one the GUI trusts. The host's old answer was
# `insecureSkipHostcheck`, which turns the check off for every caller; T2 makes the
# check the steady state and this file is what keeps the route working with it on:
# Caddy listens on loopback only, rewrites Host to the address the GUI's own config
# expects (the container's STGUIADDRESS, units/quadlet/syncthing.container), and
# forwards. Nothing here is reachable from outside this host: the site address is
# 127.0.0.1, and the port is above 1024, so the unit runs it as `caddy` with no
# capability at all. The 10000 host route is gone, so a proxy that dies is a GUI
# nobody can open -- the unit restarts, and `scripts/tailscale-serve.sh` is the
# producer if the route itself is missing.
#
# Under /usr/share and not under /etc/caddy: bootc merges a host's /etc once and
# keeps what it finds there, so a Caddyfile there would be frozen at the install's
# version and a route change would never reach a running box. /usr is the image's,
# so a deploy that bumps the image bumps this file.
# smortress-syncthing-gui-proxy.service is what passes it with `--config`.
{
	# No admin API. The config ships with the image, so changing it is a commit and
	# a deploy: with the API off there is no second answer to "what is Caddy
	# serving", and `caddy reload` has nothing to reach.
	admin off

	# No certificate and no port-80 redirect: this is plain HTTP on loopback, and
	# Caddy would otherwise try to manage TLS for the name.
	auto_https off
}

http://:8385 {
	# Hostless on purpose. Caddy matches a site's host against the request's Host,
	# and Serve forwards the client's `sync.<tailnet>` unchanged: an address of
	# 127.0.0.1 matches only a loopback Host and answers Serve an empty 200 before
	# the rewrite below can run. `bind` is what keeps the listener loopback-only.
	bind 127.0.0.1

	# Host, and not only X-Forwarded-Host: the GUI reads the request's Host when it
	# decides the check, so the value has to be the one its config trusts.
	reverse_proxy 127.0.0.1:8384 {
		header_up Host 127.0.0.1:8384
	}
}
