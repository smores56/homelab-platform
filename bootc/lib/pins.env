# Every external reference the derived images consume. Each artifact's base
# tracks a moving uCore stream tag; everything else here is hash-pinned, the
# application and Quadlet images stay digest-pinned, and the *published* server
# digest is recorded by .github/workflows/publish-server-image.yml in
# ignition/operator/derived-image.

# uCore stable-nvidia, a moving multi-arch stream tag. Nothing here pins a dated
# build: the build resolves the tag's digest and records it in the image's
# org.opencontainers.image.base.digest label and in the run summary. Upstream
# publishes new streams constantly and ghcr garbage-collects superseded digests
# within hours, so a pinned digest rots into "manifest unknown" days later; the
# counterweights are scripts/check-server-image.sh, the cosign signature on the
# derived image and `bootc rollback`. `stable-nvidia` is deliberate: uCore ships
# the NVIDIA userspace and the OpenZFS module `smortress` needs.
UCORE_TAG=stable-nvidia
UCORE_IMAGE=ghcr.io/ublue-os/ucore:${UCORE_TAG}

# uCore minimal for the public edge (design #939), the same doctrine on a
# smaller base: `stable` is the stream uCore maintains for that lineage, and the
# edge runs Caddy, a firewall and sshd, so it needs neither the NVIDIA userspace
# nor the OpenZFS module the server base carries. Nothing pins a dated build
# here either; scripts/build-image.sh edge resolves this tag's digest and the
# image records it in its org.opencontainers.image.base.digest label.
EDGE_TAG=stable
EDGE_IMAGE=ghcr.io/ublue-os/ucore-minimal:${EDGE_TAG}

# The repositories our CI pushes to. The tag is derived from the commit; the
# digest is what Ignition, bootc and the edge install path consume.
IMAGE_REPO=ghcr.io/smores56/homelab-platform/server
EDGE_IMAGE_REPO=ghcr.io/smores56/homelab-platform/edge

# Host binaries baked into the image. Releases are downloaded by the build and
# verified against these hashes, so a retagged release fails the build.
SOPS_VERSION=3.13.3
SOPS_SHA256=e5bec3346a873ae91d871550f3e698c1aad962aff462a080e40f25fde17fef6b
AGE_VERSION=1.3.2
AGE_SHA256=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
RESTIC_VERSION=0.19.1
RESTIC_SHA256=f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c

# sudo's touch factor (design #767, T8). pam_rssh is not packaged for Fedora, so
# the image clones the tag and builds the module; the tag is what the build asks
# for and the commit is what it must land on, so a retagged release fails here.
PAM_RSSH_VERSION=v1.2.1
PAM_RSSH_COMMIT=e8dd046c423f85df266c23bcc3d7033bfee81255

# CI-only binaries, downloaded with the same hash check.
BUTANE_VERSION=0.29.0
BUTANE_SHA256=53a20d820fbaa7fda4f1afd1814974badc8e448db4c151d3f1ba005dc29bc4c9
COSIGN_VERSION=2.6.1
COSIGN_SHA256=064954c5d8c7e3b28188eee5b1727b31c411550bc5fefd41aa672d3c761d103a
