[Unit]
Description=Five-minute dead-man beat for the edge's deploy receiver

[Timer]
# The same five minutes the server's deploy check runs on: a beat is what keeps a
# remote check green, so a period longer than the check's is a host that pages while
# healthy and a period shorter is one wasted request per interval. The page itself
# is the queue's age (1800 s in smoresnet-deploy-heartbeat.service), so a wedged
# drain is reported at the first beat after that limit and never before it.
OnCalendar=*-*-* *:0/5:00
AccuracySec=1s
Unit=smoresnet-deploy-heartbeat.service

[Install]
WantedBy=timers.target
