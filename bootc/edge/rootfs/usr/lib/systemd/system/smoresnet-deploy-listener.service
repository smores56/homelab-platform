[Unit]
Description=Deploy receiver on the edge's tailnet (127.0.0.1:8484)
# There is no Requires=sops-decrypt, and its absence is the point: the edge ships
# no SOPS unit, no age identity and no ciphertext, so naming one would be a
# listener that never starts. The one secret a request is authenticated against is
# plaintext 0600 at /etc/smoresnet/webhook-secret.yaml, written by the operator's
# edge-bootstrap (design #939 section 4). A missing or group-readable secret is
# this program's own refusal to start, naming the file, rather than a dependency
# that silently never satisfies.
After=network.target
After=systemd-tmpfiles-setup.service

[Service]
Type=simple
# The role is the image's choice, never the environment's: it is the repo
# allowlist, and an apps request the edge does not run would take one of the 32
# queue slots a platform deploy needs.
Environment=DEPLOY_ROLE=edge
Environment=DEPLOY_SECRETS_DIR=/etc/smoresnet
ExecStart=/usr/bin/python3 /usr/libexec/deploy-receiver.py
Restart=always
RestartSec=5
# The listener is the only process that answers the tailnet, so a wedged one is
# invisible: smoresnet-deploy-heartbeat.timer pages on a missing /healthz.
UMask=0077
User=root

# The queue is the only writable path. Everything the listener reads (the
# plaintext secrets under /etc/smoresnet, its program under /usr) stays read-only,
# and a compromised listener cannot rewrite a unit, a Quadlet or a boot file.
ProtectSystem=strict
ReadWritePaths=/var/lib/homelab/deploy
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET
RestrictNamespaces=yes

[Install]
WantedBy=multi-user.target
