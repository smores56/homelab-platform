[Unit]
Description=Daily 03:00 window that deploys whatever has been published to the edge

[Timer]
# The server's window, in the operator's local time rather than the host's UTC: a
# bad publish that lands mid-day reaches the public box once, unattended, at a
# time its owner chose. The edge does not deploy on push, so this is also the only
# trigger a release nobody dispatched ever gets.
OnCalendar=*-*-* 03:00:00 America/New_York
AccuracySec=1min
# Not persistent: a host that was off at 03:00 is not owed a deploy on the way up.
# On this box that matters twice over: it has no snapshot and no boot counting, so
# a missed window firing at boot would be a reboot with the least rollback of any
# host in the fleet.
Persistent=false
Unit=smoresnet-deploy-poll.service

[Install]
WantedBy=timers.target
