[Unit]
Description=Quarter-hour poll that deploys whatever has been published to the edge

[Timer]
# The server's cadence, not a window of its own: the edge does not deploy on push,
# so this is the only trigger a release nobody dispatched ever gets, and fifteen
# minutes is the whole of the delay between a merge and the public box.
OnCalendar=*-*-* *:0/15:00
AccuracySec=1min
# Not persistent: a host that was off is not owed a deploy on the way up. On this
# box that matters twice over: it has no snapshot and no boot counting, so every
# missed tick firing at boot would be a reboot with the least rollback of any host
# in the fleet.
Persistent=false
Unit=smoresnet-deploy-poll.service

[Install]
WantedBy=timers.target
