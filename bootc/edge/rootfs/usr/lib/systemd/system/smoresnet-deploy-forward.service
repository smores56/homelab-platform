[Unit]
# Forward the deploy receiver's port to the tailnet, the way the host does.
#
# The receiver binds 127.0.0.1:8484 (bootc/lib/deploy/deploy-receiver.py) so that
# nothing on the public interface can reach it, and the tailnet is what carries a
# notify job's POST to it. Without a forward the port exists on the box and on no
# other node, so `publish-edge-image.yml`'s notify job -- the only trigger that
# does not wait for the quarter-hour poll -- posts to a socket that answers nothing.
#
# `tailscale serve` keeps this configuration in the node's own state, so this unit
# is idempotent and survives reboots without a file: re-running it re-asserts the
# same forward. Conditioned on enrollment because a node that has not joined has
# no tailnet to serve on.
Requires=tailscaled.service
Wants=network-online.target
After=tailscaled.service smoresnet-tailscale-up.service network-online.target
ConditionPathExists=/var/lib/smoresnet/tailscale-enrolled

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/tailscale serve --bg --tcp=8484 tcp://127.0.0.1:8484
# The control plane answers this in under a second when it is healthy; a minute
# is the net that keeps a wedged socket from holding the boot path.
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
