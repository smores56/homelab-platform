# Derived uCore bootc image for the public edge (design #939, task T4). Built by
# scripts/build-image.sh edge and published by
# .github/workflows/publish-edge-image.yml.
#
# The base doctrine is bootc/server/Containerfile's, unchanged: the base is the
# uCore `stable` stream tag from bootc/lib/pins.env, not a digest-pinned build.
# Upstream publishes new streams constantly and ghcr garbage-collects superseded
# digests within hours, so a pinned digest rots into "manifest unknown" build
# failures. The build resolves the tag and passes the digest as BASE_DIGEST,
# which is what the org.opencontainers.image.base.digest label below records:
# nothing in the repository pins the base, so the built image is the only
# durable statement of what it was built on.
#
# What this image is: Caddy on 443 for the three public names, firewalld with the
# emptied public zone, sshd hardened and reachable on the tailnet only, and the
# tailnet join. Everything it ships is configuration under /usr and one sshd
# drop-in; no secret, signing key, age identity or auth key may ever enter it. The
# auth key and the Caddy environment file are the operator's, at paths the units
# name and bootc deliberately does not reconcile.

ARG BASE_IMAGE

FROM ${BASE_IMAGE}

ARG BASE_IMAGE
# The digest the tag resolved to at build time, passed by scripts/build-image.sh
# and the publish workflow. The image asserts nothing about its value; it is
# recorded so a built image still names the exact base it was built on.
ARG BASE_DIGEST

# base.name is the tag the build asked for and base.digest is what that tag
# resolved to, both recorded here because nothing in the repository pins them.
LABEL org.opencontainers.image.title="smoresnet edge image" \
      org.opencontainers.image.description="Derived uCore bootc image for the public edge" \
      org.opencontainers.image.source="https://github.com/smores56/homelab-platform" \
      org.opencontainers.image.base.name="${BASE_IMAGE}" \
      org.opencontainers.image.base.digest="${BASE_DIGEST}" \
      org.opencontainers.image.vendor="smores56"

# The packages this image adds, and the places it departs from the server's
# no-package-layer rule for stated reasons: uCore minimal carries firewalld,
# Tailscale, sshd, nftables and Podman, but no Caddy, and the edge's whole job is
# Caddy. Fedora packages it (2.11.x on f45, above the 2.6 floor the Caddyfile's
# `tls` block needs -- public-edge.md:19 records why 2.4 cannot parse it), and the
# package brings the hardened unit this image adapts rather than replaces: Type=notify,
# User=caddy and the ambient capability for binding 443 are what let a non-root
# Caddy listen on a privileged port. A hash-pinned release tarball would be the
# server's doctrine instead, at the cost of hand-rolling that unit, the account
# and the capability -- for a binary whose config is validated at build time
# below. The build fails on a Caddy older than 2.6 or without that unit.
#
# greenboot is the second package, and it is the answer to a question this
# repository used to own: boot_success/boot_counter, the health checks that run
# after boot, and the `bootc rollback` a failed one triggers are the package's
# (#941's mechanism as a distribution package rather than a snippet here). Its
# GRUB script is installed by smoresnet-boot-counter, because bootupd will not
# regenerate the grub.cfg that would source it (public-edge.md).
RUN set -eux; \
    dnf5 -y --setopt=install_weak_deps=False install caddy greenboot; \
    dnf5 clean all; \
    rm -rf /var/cache/dnf /var/cache/libdnf5

# greenboot ships its GRUB snippet for bootupd to inject, and bootupd injects
# nothing on this host: grub.cfg was generated once and is never regenerated.
# The snippet is kept as image content under the image's own path and removed
# from bootupd's directory, because a regeneration that did inject it would run
# the counter twice in one boot and spend two of the three attempts.
RUN set -eux; \
    install -d -m 0755 /usr/share/smoresnet; \
    install -m 0644 /usr/lib/bootupd/grub2-static/configs.d/08_greenboot.cfg /usr/share/smoresnet/boot-counter.cfg; \
    rm -f /usr/lib/bootupd/grub2-static/configs.d/08_greenboot.cfg

# The whole rootfs: the Caddyfile and the firewalld zones under /usr/share, the
# firewall helpers under /usr/libexec, the units under /usr/lib/systemd/system and
# the one sshd drop-in under /etc/ssh. `COPY <dir>/ /` keeps every path the tree
# names, so the tree is the whole delivery -- the same shape as the server image's
# rootfs, and the reason the publish workflow's path filter has to cover
# everything this Containerfile reads.
COPY bootc/edge/rootfs/ /

# The shared deploy decision (design #939, T2) that the edge verifier and the
# listener call, at the path both resolve it from: the program's own directory
# first, then this one. A COPY of the single file, like the server's image, keeps
# the golden fixtures out of the artifact -- they name hosts and digests and are
# test data.
COPY bootc/lib/deploy/decisions.py /usr/libexec/deploy/decisions.py
# The deploy state library the boot gate shares with the server's deploy plane:
# one implementation of the journal, the denylist, the records and the lock, so a
# gate cannot write a record the drain reads differently. The server's build
# installs it from scripts/ through the smortress-src loop, which strips the
# suffix; here it arrives as a file under the name that loop would give it, beside
# the shared output helpers. Both are sourced, never executed.
COPY scripts/lib/ /usr/libexec/lib/
COPY scripts/deploy-state.sh /usr/libexec/deploy-state
# The deploy plane's programs, under the names the units run them by (design #939,
# T8). The receiver is shared with the server and identical; the drain loop is the
# one both roles source, and the heartbeat is shared because the dead-man question
# ("is the listener answering and is its queue moving") is the same on both hosts.
# deploy-drain-edge, deploy-verify.py and edge-boot-gate are the edge rootfs's own
# and arrive with the COPY above.
COPY bootc/lib/deploy/deploy-receiver.py /usr/libexec/deploy-receiver.py
COPY bootc/lib/deploy/drain.sh /usr/libexec/deploy/drain.sh
COPY scripts/deploy-heartbeat.sh /usr/libexec/deploy-heartbeat
# The poll backstop, under the name its timer runs it by (design #939, T11). It is
# the server's program unmodified: the two hosts differ in what the unit around it
# is allowed to do, not in what a poll is.
COPY scripts/deploy-poll.sh /usr/libexec/deploy-poll

RUN set -eux; \
    chmod 0755 /usr/libexec/smoresnet-firewall-zones /usr/libexec/smoresnet-firewall-bind; \
    chmod 0755 /usr/libexec/smoresnet-firewall-prejoin; \
    chmod 0755 /usr/libexec/edge-boot-gate /usr/libexec/deploy-drain-edge; \
    chmod 0755 /usr/libexec/deploy-heartbeat /usr/libexec/deploy-poll; \
    chmod 0755 /usr/libexec/smoresnet-boot-counter; \
    chmod 0644 /usr/share/smoresnet/Caddyfile /usr/share/smoresnet/firewalld/zones/public.xml /usr/share/smoresnet/firewalld/zones/tailscale.xml; \
    chmod 0644 /usr/share/smoresnet/deploy-units.txt; \
    chmod 0644 /etc/ssh/sshd_config.d/05-edge-hardening.conf; \
    chmod 0644 /usr/lib/systemd/system/caddy.service.d/10-smoresnet.conf; \
    rm -f /etc/caddy/Caddyfile; \
    systemctl enable \
      caddy.service \
      edge-boot-gate.service \
      firewalld.service \
      greenboot-healthcheck.service \
      smoresnet-boot-counter.service \
      smoresnet-boot-rw.service \
      smoresnet-deploy-listener.service \
      smoresnet-deploy.path \
      smoresnet-deploy-forward.service \
      smoresnet-deploy-heartbeat.timer \
      smoresnet-deploy-poll.timer \
      smoresnet-firewall-zones.service \
      smoresnet-firewall-public.service \
      smoresnet-firewall-prejoin.service \
      smoresnet-firewall-tailscale.service \
      smoresnet-tailscale-up.service \
      tailscaled.service

# firewalld has to parse the shipped zones before this image can boot, and the one
# thing that proves it is firewalld's own validator: the zones are staged into
# /etc only for the check and then removed, because a zone file the image leaves
# in /etc is one bootc will never update again -- smoresnet-firewall-zones.service
# is what puts them there on every boot, from /usr/share.
RUN set -eux; \
    install -d -m 0755 /etc/firewalld/zones; \
    install -m 0644 /usr/share/smoresnet/firewalld/zones/public.xml /etc/firewalld/zones/public.xml; \
    install -m 0644 /usr/share/smoresnet/firewalld/zones/tailscale.xml /etc/firewalld/zones/tailscale.xml; \
    firewall-offline-cmd --set-default-zone=drop; \
    firewall-offline-cmd --check-config; \
    rm -f /etc/firewalld/zones/public.xml /etc/firewalld/zones/tailscale.xml

# The Caddyfile is parsed here, not on the box: `caddy validate` loads the config
# without provisioning certificates, and the three operator values it substitutes
# are supplied as placeholders so a syntax error fails this build rather than
# crash-looping caddy.service on a public box. HOME and the XDG paths point at
# /tmp because caddy validates as a user whose home is created at first boot.
RUN set -eux; \
    EDGE_ACME_EMAIL=acme@example.invalid \
    IMMICH_UPSTREAM=https://immich.example.invalid \
    OPDS_UPSTREAM=https://opds.example.invalid \
    HOME=/tmp XDG_CONFIG_HOME=/tmp/caddy-config XDG_DATA_HOME=/tmp/caddy-data \
      caddy validate --config /usr/share/smoresnet/Caddyfile --adapter caddyfile

# sshd's policy is the only route into this box, so a drop-in it refuses to parse
# would take the host off the network with no recovery but the provider's VNC
# console. A build carries no host keys yet and sshd refuses to start without one,
# so the check runs against a throwaway key that is deleted in the same layer. The
# two -T queries are what prove the policy itself, not just that it parses: one
# arrival from a public address and one from loopback, both key-only. The keyword
# match is case-insensitive because OpenSSH 10 prints CamelCase names, and a
# lowercase comparison would read "no output" as success.
RUN set -eux; \
    mkdir -p /run/sshd; \
    tmp=$(mktemp -d); \
    ssh-keygen -q -t ed25519 -N '' -f "$tmp/hostkey"; \
    sshd -t -o HostKey="$tmp/hostkey"; \
    for addr in 203.0.113.7 127.0.0.1; do \
      test "$(sshd -T -o HostKey="$tmp/hostkey" -C addr="$addr",user=root | awk 'tolower($1) == "passwordauthentication" { print tolower($2) }')" = no || { \
        echo "sshd accepts a password from $addr; the edge is keys only" >&2; exit 1; }; \
      test "$(sshd -T -o HostKey="$tmp/hostkey" -C addr="$addr",user=root | awk 'tolower($1) == "permitrootlogin" { print tolower($2) }')" = prohibit-password || { \
        echo "sshd permits more than a key login for root from $addr" >&2; exit 1; }; \
    done; \
    rm -rf "$tmp"

# Fail the build if the base is not a stream tag, or if the rootfs did not arrive
# whole. Each assertion is a property the edge's checks and the deploy gate
# predicate on, and every one of them is cheap here and expensive on a box whose
# console is a provider's VNC page.
RUN set -eux; \
    test -x /usr/libexec/deploy-verify.py || { echo "the edge verifier is missing or not executable: nothing would verify a deploy"; exit 1; }; \
    test -f /usr/libexec/deploy/decisions.py || { echo "the shared deploy decision is missing: the verifier would refuse to start"; exit 1; }; \
    case "${BASE_IMAGE}" in \
      *:latest) echo "BASE_IMAGE must be a stream tag, not :latest: ${BASE_IMAGE}" >&2; exit 1 ;; \
      *@sha256:*) echo "BASE_IMAGE must be a stream tag, not a digest: ${BASE_IMAGE}" >&2; exit 1 ;; \
      *:*) ;; \
      *) echo "BASE_IMAGE must be a tagged reference: ${BASE_IMAGE}" >&2; exit 1 ;; \
    esac; \
    test -n "${BASE_DIGEST}" || { echo "BASE_DIGEST is empty: the image would not record the base it was built on" >&2; exit 1; }; \
    test -f /usr/bin/caddy || { echo "caddy is missing: the edge has nothing to serve with" >&2; exit 1; }; \
    test -f /usr/lib/systemd/system/caddy.service || { echo "the caddy package no longer ships caddy.service; 10-smoresnet.conf has no unit to modify" >&2; exit 1; }; \
    test -f /usr/lib/systemd/system/caddy.service.d/10-smoresnet.conf || { echo "the caddy drop-in is missing: Caddy would read a Caddyfile this image does not ship" >&2; exit 1; }; \
    grep -qF -- '--config /usr/share/smoresnet/Caddyfile' /usr/lib/systemd/system/caddy.service.d/10-smoresnet.conf || { echo "the caddy unit does not pass --config for the image's Caddyfile" >&2; exit 1; }; \
    test ! -e /etc/caddy/Caddyfile || { echo "/etc/caddy/Caddyfile exists: bootc keeps a host's /etc, so it would shadow the image's config on a running box" >&2; exit 1; }; \
    test -x /usr/libexec/smoresnet-firewall-zones || { echo "the zones helper is not executable: smoresnet-firewall-zones.service would fail 203/EXEC" >&2; exit 1; }; \
    test -x /usr/libexec/edge-boot-gate || { echo "the boot gate is missing or not executable: edge-boot-gate.service would fail 203/EXEC and nothing would judge a deployment" >&2; exit 1; }; \
    test -r /usr/libexec/deploy-state || { echo "the deploy state library is missing: the boot gate sources it for every record" >&2; exit 1; }; \
    test -r /usr/libexec/lib/log.sh || { echo "the output helpers are missing: the boot gate prints through them" >&2; exit 1; }; \
    grep -qx caddy.service /usr/share/smoresnet/deploy-units.txt || { echo "caddy is not a deploy-critical unit: a box that boots without it is judged healthy and never rolled back" >&2; exit 1; }; \
    test -x /usr/libexec/smoresnet-firewall-bind || { echo "the bind helper is not executable: the firewall units would fail 203/EXEC" >&2; exit 1; }; \
    test -f /usr/share/smoresnet/firewalld/zones/public.xml || { echo "the public zone is missing" >&2; exit 1; }; \
    ! grep -q '<service' /usr/share/smoresnet/firewalld/zones/public.xml || { echo "the public zone carries a service list; stock public ships ssh, which would publish sshd on the internet" >&2; exit 1; }; \
    grep -q '<port port="443" protocol="tcp"/>' /usr/share/smoresnet/firewalld/zones/public.xml; \
    grep -q '<port port="41641" protocol="udp"/>' /usr/share/smoresnet/firewalld/zones/public.xml; \
    grep -q '<icmp-block name="echo-request"/>' /usr/share/smoresnet/firewalld/zones/public.xml; \
    grep -q '<interface name="tailscale0"/>' /usr/share/smoresnet/firewalld/zones/tailscale.xml; \
    ! grep -rlE '^[[:space:]]*PasswordAuthentication[[:space:]]+yes' /etc/ssh/sshd_config.d | grep -qv '90-enable-localhost-passwords.conf' || { echo "a password-auth sshd drop-in shipped: the edge is keys only" >&2; exit 1; }; \
    grep -qF -- '--ssh=false' /usr/lib/systemd/system/smoresnet-tailscale-up.service || { echo "the join unit does not turn Tailscale SSH off" >&2; exit 1; }; \
    grep -qF -- 'LoadCredential=tailscale-authkey' /usr/lib/systemd/system/smoresnet-tailscale-up.service || { echo "the join unit does not read its key from a credential" >&2; exit 1; }; \
    test ! -e /etc/smoresnet/tailscale-authkey || { echo "an auth key is in the image: it is the operator's, and never image content" >&2; exit 1; }; \
    test -x /usr/libexec/deploy-drain-edge || { echo "the edge drain is missing or not executable: smoresnet-deploy.service would fail 203/EXEC and the queue would never be consumed" >&2; exit 1; }; \
    test -r /usr/libexec/deploy/drain.sh || { echo "the shared drain loop is missing: the edge drain has nothing to run" >&2; exit 1; }; \
    test -r /usr/libexec/deploy-receiver.py || { echo "the deploy receiver is missing: nothing would answer the tailnet on 8484" >&2; exit 1; }; \
    test -x /usr/libexec/deploy-heartbeat || { echo "the deploy heartbeat is missing or not executable: smoresnet-deploy-heartbeat.service would fail 203/EXEC and a wedged queue would never page" >&2; exit 1; }; \
    ! grep -qE '^(Requires|Wants)=.*sops-decrypt' /usr/lib/systemd/system/smoresnet-deploy-listener.service || { echo "the edge listener depends on a sops unit this image does not ship: it would never start" >&2; exit 1; }; \
    grep -qxF 'Environment=DEPLOY_SECRETS_DIR=/etc/smoresnet' /usr/lib/systemd/system/smoresnet-deploy-listener.service || { echo "the edge listener does not read its secret from /etc/smoresnet" >&2; exit 1; }; \
    test ! -e /etc/smoresnet/webhook-secret.yaml || { echo "a webhook secret is in the image: it is the operator's, written by edge-bootstrap" >&2; exit 1; }; \
    test ! -e /etc/caddy/edge.env || { echo "the Caddy environment file is in the image: its upstreams are the operator's" >&2; exit 1; }; \
    test -x /usr/libexec/deploy-poll || { echo "the deploy poll is missing or not executable: smoresnet-deploy-poll.service would fail 203/EXEC and a release nobody dispatched would never land" >&2; exit 1; }; \
    test -f /usr/lib/systemd/system/smoresnet-deploy-poll.timer || { echo "the poll timer is missing: nothing would run the backstop" >&2; exit 1; }; \
    grep -qxF 'ExecStart=/usr/libexec/deploy-poll' /usr/lib/systemd/system/smoresnet-deploy-poll.service || { echo "the poll unit does not run the installed program" >&2; exit 1; }; \
    grep -qxF 'After=edge-boot-gate.service' /usr/lib/systemd/system/smoresnet-deploy-poll.service || { echo "the poll is not ordered after the boot gate: a missed window would enqueue the deployment the host is already running" >&2; exit 1; }; \
    ! grep -qE '^(Requires|Wants)=.*sops-decrypt' /usr/lib/systemd/system/smoresnet-deploy-poll.service || { echo "the edge poll depends on a sops unit this image does not ship: the backstop would never run" >&2; exit 1; }; \
    grep -qxF 'ReadWritePaths=/var/lib/homelab/deploy' /usr/lib/systemd/system/smoresnet-deploy-poll.service || { echo "the poll cannot write the queue it is meant to fill" >&2; exit 1; }; \
    grep -qxF 'Environment=DEPLOY_POLL_REPOS=homelab-platform' /usr/lib/systemd/system/smoresnet-deploy-poll.service || { echo "the poll polls a repository this box does not deploy: an apps request would take one of the 32 queue slots" >&2; exit 1; }; \
    grep -qxF 'OnCalendar=*-*-* 03:00:00 America/New_York' /usr/lib/systemd/system/smoresnet-deploy-poll.timer || { echo "the poll window is not the operator's 03:00 local" >&2; exit 1; }; \
    test -e /etc/systemd/system/timers.target.wants/smoresnet-deploy-poll.timer || { echo "the poll timer is not enabled: the backstop would never fire" >&2; exit 1; }; \
    grep -qxF 'DirectoryNotEmpty=/var/lib/homelab/deploy/queue' /usr/lib/systemd/system/smoresnet-deploy.path || { echo "the queue does not start the drain: a trigger would enqueue a request nothing consumes" >&2; exit 1; }; \
    grep -qxF 'Unit=smoresnet-deploy.service' /usr/lib/systemd/system/smoresnet-deploy.path || { echo "the path unit does not start the edge drain" >&2; exit 1; }; \
    test -e /etc/systemd/system/paths.target.wants/smoresnet-deploy.path || { echo "the queue path unit is not enabled: both triggers would enqueue into a queue nobody drains" >&2; exit 1; }; \
    test -x /usr/libexec/smoresnet-firewall-prejoin || { echo "the pre-join firewall helper is missing: a host that cannot join the tailnet would have no way in at all" >&2; exit 1; }; \
    grep -qxF 'ExecStart=/usr/libexec/smoresnet-firewall-prejoin' /usr/lib/systemd/system/smoresnet-firewall-prejoin.service || { echo "the pre-join unit does not run the installed helper" >&2; exit 1; }; \
    test -e /etc/systemd/system/multi-user.target.wants/smoresnet-firewall-prejoin.service || { echo "the pre-join unit is not enabled: the public ssh window would never be decided" >&2; exit 1; }; \
    grep -qxF 'ExecStart=/usr/bin/tailscale serve --bg --tcp=8484 tcp://127.0.0.1:8484' /usr/lib/systemd/system/smoresnet-deploy-forward.service || { echo "the deploy forward does not advertise the receiver: a notify job would post to a port only this host can reach" >&2; exit 1; }; \
    test -f /usr/lib/tmpfiles.d/smoresnet-deploy.conf || { echo "the deploy state fragment is missing: /var/lib/homelab/deploy would not exist and every deploy unit's ReadWritePaths would fail" >&2; exit 1; }; \
    grep -qxF 'd /var/lib/homelab/deploy/queue 0700 root root -' /usr/lib/tmpfiles.d/smoresnet-deploy.conf || { echo "the deploy state fragment does not create the queue: smoresnet-deploy.path would never fire and a request would sit undrained" >&2; exit 1; }; \
    test ! -e /etc/tmpfiles.d/smoresnet-deploy.conf || { echo "/etc/tmpfiles.d/smoresnet-deploy.conf shadows the deploy state fragment: bootc never replaces a host's /etc, so the deploy tree would stop being created" >&2; exit 1; }; \
    test ! -L /etc/tmpfiles.d/smoresnet-deploy.conf || { echo "/etc/tmpfiles.d/smoresnet-deploy.conf is a mask: the deploy tree would never be created and every deploy unit would fail on its ReadWritePaths" >&2; exit 1; }; \
    test -f /etc/tmpfiles.d/smoresnet-edge.conf || { echo "the edge state fragment is missing: Caddy would start with no /var/lib/caddy, fail every ACME order with 'mkdir /var/lib/caddy: permission denied' and answer 500 on all three names" >&2; exit 1; }; \
    grep -qxF 'd /var/lib/caddy 0750 caddy caddy -' /etc/tmpfiles.d/smoresnet-edge.conf || { echo "the edge state fragment does not create Caddy's storage directory as Caddy's own account: every ACME order would fail" >&2; exit 1; }; \
     grep -qxF 'd /var/lib/smoresnet 0700 root root -' /etc/tmpfiles.d/smoresnet-edge.conf || { echo "the edge state fragment does not create /var/lib/smoresnet: edge-boot-gate.service fails with 226/NAMESPACE in namespace setup on the boot after an install" >&2; exit 1; }; \
    rpm -q greenboot >/dev/null || { echo "greenboot is not installed: this host would have no boot counter and no after-boot rollback" >&2; exit 1; }; \
    test -x /usr/libexec/smoresnet-boot-counter || { echo "the boot counter installer is missing or not executable: the counter would never reach the grub.cfg that reads it" >&2; exit 1; }; \
    test ! -e /usr/lib/bootupd/grub2-static/configs.d/08_greenboot.cfg || { echo "greenboot's snippet is still in bootupd's directory: a regeneration would install the counter twice and spend two attempts in one boot" >&2; exit 1; }; \
    test -f /usr/share/smoresnet/boot-counter.cfg || { echo "the boot counter snippet is missing: the installer has nothing to put where grub.cfg reads it" >&2; exit 1; }; \
    grep -q 'boot_counter' /usr/share/smoresnet/boot-counter.cfg || { echo "the shipped boot counter snippet does not read boot_counter: the counter would never move" >&2; exit 1; }; \
    test -e /etc/systemd/system/multi-user.target.wants/smoresnet-boot-counter.service || { echo "the boot counter installer is not enabled: nothing would put the counter where grub.cfg reads it" >&2; exit 1; }; \
    test -e /etc/systemd/system/multi-user.target.wants/smoresnet-boot-rw.service || { echo "/boot is left read-only: greenboot cannot write grubenv and the counter never arms" >&2; exit 1; }; \
    test -e /etc/systemd/system/multi-user.target.wants/greenboot-healthcheck.service || { echo "greenboot's healthcheck is not enabled: a deployment that boots but is broken would never be rolled back" >&2; exit 1; }; \
    grep -qxF 'ReadWritePaths=/var/lib/caddy' /usr/lib/systemd/system/caddy.service.d/10-smoresnet.conf || { echo "the caddy unit no longer names its storage directory: the path would leave bootc/edge/unit-paths.tsv, and with it the check that something creates it" >&2; exit 1; }; \
    test -e /etc/systemd/system/multi-user.target.wants/smoresnet-deploy-forward.service || { echo "the deploy forward is not enabled: dispatch-triggered deploys would never arrive" >&2; exit 1; }
